---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl px-4 sm:px-6 pt-24 scroll-mt-14" aria-labelledby={`${id}-title`}>
  <header class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="font-mono text-xs text-accent uppercase tracking-[0.14em] mb-3">{eyebrow}</p>
      <h2 id={`${id}-title`} class="text-2xl sm:text-3xl font-semibold tracking-tight">{title}</h2>
      {lead && <p class="mt-3 text-muted leading-relaxed">{lead}</p>}
    </div>
    <slot name="aside" />
  </header>
  <slot />
</section>

---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { SITE } from '../lib/site';
import { t, localePath, switchPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const other: Lang = lang === 'en' ? 'it' : 'en';

const nav = [
  { href: '/#work', label: T.nav.work },
  { href: '/#education', label: T.nav.education },
  { href: '/#open-source', label: T.nav.openSource },
  { href: '/#contact', label: T.nav.contact },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-bg/75">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 h-14 flex items-center gap-6">
    <a href={localePath(lang, '/')} class="flex items-center gap-2.5 font-medium tracking-tight shrink-0" aria-label="Home">
      <Mark size={28} disc class="rounded-full" />
      <span class="hidden sm:inline">{SITE.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm text-muted" aria-label="Main">
      {nav.map((n) => (
        <a href={localePath(lang, n.href)} class="px-3 py-1.5 rounded-lg hover:text-fg hover:bg-surface-2 transition-colors">{n.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={switchPath(Astro.url, other)}
        hreflang={other}
        lang={other}
        title={T.switchLang}
        aria-label={T.switchLang}
        class="h-8 px-2.5 grid place-items-center rounded-lg font-mono text-xs uppercase tracking-wider text-muted hover:text-fg hover:bg-surface-2 transition-colors"
      >
        {other}
      </a>
      <button
        type="button"
        data-theme-toggle
        class="size-8 grid place-items-center rounded-lg text-muted hover:text-fg hover:bg-surface-2 transition-colors"
        aria-label={T.themeToggle}
      >
        <Icon name="sun" size={16} class="hidden dark:block" />
        <Icon name="moon" size={16} class="dark:hidden" />
      </button>
    </div>
  </div>
</header>

<script>
  function setup() {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>

---
/* The site header: the name, one link per section of the home page in its order, the language and the theme.
   From 1024px the links sit in the bar; below, a menu button opens them in a panel under it. On the home page
   the link of the section in view is marked (aria-current), so the bar doubles as a table of contents. */
import Symbol from './Symbol.astro';
import Mark from './Mark.astro';
import { SITE } from '../lib/site';
import { t, localePath, switchPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const other: Lang = lang === 'en' ? 'it' : 'en';

// in the order of the home page
const nav = [
  { id: 'work', label: T.nav.work },
  { id: 'more', label: T.nav.tools },
  { id: 'built-with', label: T.nav.builtWith },
  { id: 'education', label: T.nav.education },
  { id: 'activity', label: T.nav.activity },
  { id: 'open-source', label: T.nav.openSource },
  { id: 'contact', label: T.nav.contact },
];
---

<header class="site-header sticky top-0 z-40 bg-bg" data-header>
  <div class="mx-auto max-w-[84rem] px-4 sm:px-6 h-14 flex items-center gap-4 xl:gap-6">
    <a href={localePath(lang, '/')} class="flex items-center gap-2.5 font-medium tracking-tight shrink-0" aria-label="Home">
      <Mark size={28} disc class="rounded-full" />
      <span class="hidden sm:inline">{SITE.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 text-sm text-muted" aria-label="Main">
      {nav.map((n) => (
        <a href={localePath(lang, `/#${n.id}`)} data-section={n.id} class="nav-link px-2.5 xl:px-3 py-1.5 rounded-lg whitespace-nowrap hover:text-fg hover:bg-surface-2 transition-colors">
          {n.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={switchPath(Astro.url, other)}
        hreflang={other}
        lang={other}
        title={T.switchLang}
        aria-label={T.switchLang}
        class="h-8 px-2.5 grid place-items-center rounded-lg font-mono text-xs uppercase tracking-wider text-muted hover:text-fg hover:bg-surface-2 transition-colors"
      >
        {other}
      </a>
      <button
        type="button"
        data-theme-toggle
        class="size-8 grid place-items-center rounded-lg text-muted hover:text-fg hover:bg-surface-2 transition-colors"
        aria-label={T.themeToggle}
      >
        <Symbol name="light_mode" size={18} class="hidden dark:block" />
        <Symbol name="dark_mode" size={18} class="dark:hidden" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={T.nav.menu}
        class="lg:hidden size-8 grid place-items-center rounded-lg text-muted hover:text-fg hover:bg-surface-2 transition-colors"
      >
        <Symbol name="menu" size={20} class="menu-open" />
        <Symbol name="close" size={20} class="menu-close" />
      </button>
    </div>
  </div>

  <!-- below 1024px: the same links, in a panel under the bar -->
  <nav id="site-menu" class="site-menu lg:hidden" aria-label="Main" hidden>
    <ul class="mx-auto max-w-[84rem] px-4 sm:px-6 py-2">
      {nav.map((n) => (
        <li>
          <a href={localePath(lang, `/#${n.id}`)} data-section={n.id} class="nav-link">
            {n.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* a hairline under the header once the page has scrolled under it, fading in; the header stays solid */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--c-border);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .site-header[data-scrolled]::after {
    opacity: 1;
  }
  .nav-link[aria-current='true'] {
    color: var(--c-fg);
    background: var(--c-surface-2);
  }
  /* the icons are Symbol's own elements, out of this component's scope */
  [data-menu-toggle] :global(.menu-close),
  [data-menu-toggle][aria-expanded='true'] :global(.menu-open) {
    display: none;
  }
  [data-menu-toggle][aria-expanded='true'] :global(.menu-close) {
    display: block;
  }
  .site-menu {
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
  }
  .site-menu ul {
    list-style: none;
    margin-block: 0;
  }
  .site-menu a {
    display: block;
    padding: 12px;
    margin-inline: -12px;
    border-radius: 10px;
    font-size: 17px;
    color: var(--c-muted);
  }
  .site-menu a:hover {
    color: var(--c-fg);
  }
</style>

<script>
  let page = new AbortController();

  function setup() {
    page.abort();
    page = new AbortController();
    const signal = page.signal;

    document.querySelector('[data-theme-toggle]')?.addEventListener(
      'click',
      () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      },
      { signal },
    );

    const header = document.querySelector<HTMLElement>('[data-header]');

    // the hairline: a 1px sentinel at the top of the page tells when content has gone under the header
    if (header) {
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none';
      document.body.prepend(sentinel);
      const io = new IntersectionObserver(([e]) => header.toggleAttribute('data-scrolled', !e.isIntersecting));
      io.observe(sentinel);
      signal.addEventListener('abort', () => (io.disconnect(), sentinel.remove()));
    }

    // the menu below 1024px: a link, Escape, a click outside or a wider window close it
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('#site-menu');
    if (header && btn && menu) {
      const open = (on: boolean) => {
        menu.hidden = !on;
        btn.setAttribute('aria-expanded', String(on));
      };
      btn.addEventListener('click', () => open(menu.hidden), { signal });
      menu.addEventListener('click', (e) => (e.target as Element).closest('a') && open(false), { signal });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && (open(false), btn.focus()), { signal });
      document.addEventListener('click', (e) => !menu.hidden && !header.contains(e.target as Node) && open(false), { signal });
      matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && open(false), { signal });
    }

    // on the home page, mark the section in view: the last one whose top has passed under the header
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-header] [data-section]')];
    const sections = [...new Set(links.map((a) => a.dataset.section!))]
      .map((id) => document.getElementById(id))
      .filter((s): s is HTMLElement => s !== null);
    if (!sections.length) return;
    let frame = 0;
    const mark = () => {
      frame = 0;
      const line = 56 + innerHeight * 0.3;
      let current: string | undefined;
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      // at the very bottom the last section is the one in view, however short
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections[sections.length - 1].id;
      links.forEach((a) => (a.dataset.section === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(mark)), { passive: true, signal });
    mark();
  }
  document.addEventListener('astro:page-load', setup);
</script>

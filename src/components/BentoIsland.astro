<script>
  function setup() {
    // chart: point at a bar to read that week
    document.querySelectorAll<HTMLElement>('[data-chart]').forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = '1';
      const out = el.querySelector<HTMLElement>('.bx-readout')!;
      const bars = [...el.querySelectorAll<SVGRectElement>('rect:not(.hit)')];
      const box = el.querySelector('.bx-bars')!;
      el.querySelectorAll<SVGRectElement>('rect.hit').forEach((hit, i) => {
        hit.addEventListener('pointerenter', () => {
          bars.forEach((b, j) => b.classList.toggle('sel', j === i));
          out.textContent = hit.dataset.text ?? '';
        });
      });
      box.addEventListener('pointerleave', () => {
        bars.forEach((b) => b.classList.remove('sel'));
        out.textContent = el.dataset.label ?? '';
      });
    });

    // dependents: hover or tap a tick to switch the screen; phones show the next one beside it
    document.querySelectorAll<HTMLElement>('.bx-dep').forEach((tile) => {
      if (tile.dataset.ready) return;
      tile.dataset.ready = '1';
      const btns = [...tile.querySelectorAll<HTMLButtonElement>('.bx-views button')];
      const imgs = [...tile.querySelectorAll<HTMLImageElement>('.bx-shot img')];
      const label = tile.querySelector<HTMLElement>('.bx-vname');
      if (!btns.length) return;
      const phone = tile.classList.contains('bx-phone');
      const set = (i: number) => {
        imgs.forEach((im, j) => {
          im.classList.toggle('on', j === i);
          im.classList.toggle('on2', phone && j === (i + 1) % imgs.length && j !== i);
        });
        btns.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
        if (label) label.textContent = btns[i].title;
      };
      btns.forEach((b, i) => {
        b.addEventListener('click', () => set(i));
        b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && set(i));
      });
    });
  }

  // gallery: a click on a dependent opens its screen large; arrows, keys and swipes walk through every
  // screenshot of the island, project after project
  type Shot = { src: string; portrait: boolean; framed: boolean; alt: string; view: string; name: string; repo: string; stars: string; note: string; i: number; n: number };

  function setupGallery(island: HTMLElement) {
    const dlg = island.querySelector<HTMLDialogElement>('.bx-lb');
    if (!dlg) return;
    const shots: Shot[] = JSON.parse(dlg.querySelector('script')!.textContent ?? '[]');
    const img = dlg.querySelector<HTMLImageElement>('.bx-lb-stage img')!;
    const q = <T extends HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
    let at = 0;

    const show = (k: number) => {
      at = (k + shots.length) % shots.length;
      const s = shots[at];
      img.classList.add('loading');
      img.onload = () => img.classList.remove('loading');
      img.src = s.src;
      img.alt = s.alt;
      img.className = [s.portrait && 'portrait', s.framed && 'framed', 'loading'].filter(Boolean).join(' ');
      q('.bx-lb-name').textContent = s.name;
      const gh = q<HTMLAnchorElement>('.bx-lb-gh');
      gh.href = `https://github.com/${s.repo}`;
      gh.querySelector('span')!.textContent = s.repo;
      q('.bx-lb-stars span').textContent = s.stars;
      q('.bx-lb-view').textContent = s.view;
      q('.bx-lb-count').textContent = `${s.i} / ${s.n}`;
      q('.bx-lb-note').textContent = s.note;
      // warm the next one
      new Image().src = shots[(at + 1) % shots.length].src;
    };

    island.querySelectorAll<HTMLElement>('.bx-dep[data-start]').forEach((tile) => {
      const start = Number(tile.dataset.start);
      const open = () => {
        const pressed = [...tile.querySelectorAll('.bx-views button')].findIndex((b) => b.getAttribute('aria-pressed') === 'true');
        show(start + Math.max(0, pressed));
        dlg.showModal();
      };
      tile.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, .bx-views')) return;
        open();
      });
    });

    q('.bx-lb-prev').addEventListener('click', () => show(at - 1));
    q('.bx-lb-next').addEventListener('click', () => show(at + 1));
    q('.bx-lb-close').addEventListener('click', () => dlg.close());
    // a click on the backdrop (the dialog itself, outside the image and the controls) closes it
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || e.target === q('.bx-lb-stage')) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => (x0 = e.pointerType === 'mouse' ? null : e.clientX));
    dlg.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.bx-island').forEach((island) => {
      if (island.dataset.gallery) return;
      island.dataset.gallery = '1';
      setupGallery(island);
    });
  });
  // used-by faces: name the one under the pointer in the tile's footer
  function setupFaces() {
    document.querySelectorAll<HTMLElement>('.bx-intro').forEach((tile) => {
      if (tile.dataset.ready) return;
      tile.dataset.ready = '1';
      const out = tile.querySelector<HTMLElement>('.bx-faces-out [data-rest]');
      if (!out) return;
      const rest = () => (out.textContent = out.dataset.rest ?? '');
      tile.querySelectorAll<HTMLAnchorElement>('.bx-faces a').forEach((a) => {
        const say = () => (out.textContent = a.dataset.tip ?? '');
        a.addEventListener('pointerenter', say);
        a.addEventListener('focus', say);
        a.addEventListener('pointerleave', rest);
        a.addEventListener('blur', rest);
      });
    });
  }
  document.addEventListener('astro:page-load', setupFaces);
  document.addEventListener('astro:page-load', setup);
</script>

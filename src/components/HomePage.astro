---
import Base from '../layouts/Base.astro';
import Section from './Section.astro';
import Icon from './Icon.astro';
import Sparkline from './Sparkline.astro';
import FeaturedProject from './FeaturedProject.astro';
import RepoCard from './RepoCard.astro';
import ProjectCard from './ProjectCard.astro';
import ContributionGraph from './ContributionGraph.astro';
import CodeLanguages from './CodeLanguages.astro';
import CopyEmail from './CopyEmail.astro';
import EducationTimeline from './EducationTimeline.astro';
import Languages from './Languages.astro';
import Octicon from './Octicon.astro';
import BrandIcon, { type BrandKey } from './BrandIcon.astro';
import { SITE, SOCIALS, education, projectGroups, languages } from '../lib/site';
import { getProjects } from '../lib/projects';
import { t, type Lang } from '../lib/i18n';
import { getRepos, getPackages, getContributions, getUpstreamPRs, getResolvedIssues, getCodeLanguages, compact } from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const PROJECT_GROUPS = projectGroups(lang);

const HIDDEN_REPOS = new Set([SITE.handle, 'my-portfolio', 'svg-icons']);

const projects = await getProjects(lang);

const [repos, packages, contrib, prs, resolvedIssues, codeLanguages] = await Promise.all([
  getRepos(),
  getPackages(),
  getContributions(),
  getUpstreamPRs(),
  getResolvedIssues(),
  getCodeLanguages(),
]);

const own = repos.filter((r) => !r.fork && !r.archived && !HIDDEN_REPOS.has(r.name));
const totalStars = own.reduce((s, r) => s + r.stargazers_count, 0);
const covered = new Set(projects.flatMap((p) => [p.data.repo, ...p.data.alsoCovers]).filter(Boolean));
const moreRepos = own
  .filter((r) => !covered.has(r.name))
  .sort((a, b) => b.stargazers_count - a.stargazers_count || +new Date(b.pushed_at) - +new Date(a.pushed_at));

// bucket case studies and leftover repos into groups; empty groups are dropped
const placed = new Set(PROJECT_GROUPS.flatMap((g) => g.repos));
const groups = PROJECT_GROUPS.map((g) => {
  const inGroup = projects.filter((p) => p.data.group === g.id);
  return {
    ...g,
    featured: inGroup.filter((p) => p.data.featured),
    secondary: inGroup.filter((p) => !p.data.featured),
    repos: moreRepos.filter((r) => (g.id === 'other' ? !placed.has(r.name) : g.repos.includes(r.name))),
  };
})
  .map((g) => ({ ...g, count: g.featured.length + g.secondary.length + g.repos.length }))
  .filter((g) => g.count > 0);

// box-in-box tiles, the same as the project cards
const tile = 'rounded-[6px] bg-surface min-w-0';
const downloads30d = packages.reduce((s, p) => s + p.downloads30d, 0);
const totalLikes = packages.reduce((s, p) => s + p.likes, 0);
const stats = [
  { href: 'https://github.com/ales-drnz?tab=repositories&sort=stargazers', external: true, icon: 'star-fill', color: 'text-star', label: T.stars, value: totalStars },
  { href: SOCIALS[1].url, external: true, icon: 'thumbsup', color: 'text-accent', label: T.likes, value: totalLikes },
  { href: '#open-source', external: false, icon: 'git-merge', color: 'text-merged', label: T.upstreamPRs, value: prs.length },
  {
    href: 'https://github.com/issues?q=user%3Aales-drnz+type%3Aissue+is%3Aclosed+reason%3Acompleted+-author%3Aales-drnz',
    external: true,
    icon: 'issue-closed',
    color: 'text-ok',
    label: T.issuesResolved,
    value: resolvedIssues,
  },
] as const;
// sum weekly series aligned on the most recent week
const weeks = Math.max(0, ...packages.map((p) => p.weekly.length));
const weeklyTotal = Array.from({ length: weeks }, (_, i) =>
  packages.reduce((s, p) => s + (p.weekly[p.weekly.length - weeks + i] ?? 0), 0),
);

// merged upstream PRs, grouped by repository
const prGroups = Object.entries(
  prs.reduce<Record<string, typeof prs>>((acc, pr) => ((acc[pr.repo] ??= []).push(pr), acc), {}),
).sort((a, b) => b[1].length - a[1].length);
---

<Base lang={lang}>
  <!-- ===================== HERO ===================== -->
  <section class="relative">
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 pt-16 sm:pt-24">
      <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
        <!-- intro -->
        <div class="relative overflow-hidden md:col-span-2 md:row-span-2 rounded-2xl bg-surface/80 backdrop-blur p-6 sm:p-8 flex flex-col justify-center">
          <h1 class="relative text-3xl sm:text-[2.6rem] leading-[1.1] font-semibold tracking-tight text-balance">
            <Fragment set:html={T.headline} />
          </h1>
          <p class="relative mt-5 text-muted leading-relaxed max-w-xl">
            {T.studies}
          </p>

          <div class="relative mt-8 flex flex-wrap items-center gap-3">
            <CopyEmail lang={lang} />
            <div class="flex items-center gap-0.5 ml-1">
              {SOCIALS.slice(0, 3).map((s) => (
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label} class="size-10 grid place-items-center rounded-lg text-muted hover:text-fg hover:bg-surface-2 transition-colors">
                  <Icon name={s.id} size={17} />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- pub.dev tile -->
        <a href={SOCIALS[1].url} target="_blank" rel="noopener" class="hover-card group flex flex-col gap-2 p-2 rounded-2xl bg-surface-2">
          <div class:list={[tile, 'px-4 py-3 flex items-center justify-between text-sm text-muted']}>
            <span class="flex items-center gap-2"><Octicon name="download" size={14} /> {T.pubDownloads}</span>
            <Icon name="arrow-up-right" size={14} class="text-subtle group-hover:text-fg transition-colors" />
          </div>
          <div class:list={[tile, 'relative flex-1 overflow-hidden px-4 pt-3 pb-14']}>
            <p class="relative z-10 text-3xl font-semibold tracking-tight tabular-nums">
              {compact(downloads30d)}<span class="text-base font-normal text-subtle"> {T.perMonth}</span>
            </p>
            <Sparkline edge values={weeklyTotal.slice(-26)} width={260} height={56} label={T.weeklyAll} class="absolute inset-x-0 bottom-0 h-14 w-full" />
          </div>
        </a>

        <!-- numbers tile -->
        <div class="grid grid-cols-2 gap-2 p-2 rounded-2xl bg-surface-2">
          {stats.map((s) => (
            <a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined} class:list={['hover-card', tile, 'px-3 py-3 flex flex-col justify-between gap-3']}>
              <span class="flex items-center gap-1.5 text-xs text-subtle"><Octicon name={s.icon} size={12} class={s.color} /> {s.label}</span>
              <span class="text-xl font-semibold tracking-tight tabular-nums">{s.value}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WORK ===================== -->
  <Section id="work" eyebrow={T.work.eyebrow} title={T.work.title} lead={T.work.lead}>
    <nav slot="aside" class="flex flex-wrap gap-2" aria-label={T.work.groups}>
      {groups.map((g) => (
        <a href={`#group-${g.id}`} class="inline-flex items-center gap-2 h-8 px-3 rounded-lg bg-surface text-sm text-muted hover:text-fg hover:bg-surface-2 transition-colors">
          {g.brand ? <BrandIcon name={g.brand as BrandKey} size={13} /> : <Octicon name={g.octicon as any} size={13} />}
          {g.title}
          <span class="font-mono text-xs text-subtle tabular-nums">{g.count}</span>
        </a>
      ))}
    </nav>

    <div class="space-y-16">
      {groups.map((g) => (
        <div id={`group-${g.id}`} class="scroll-mt-20">
          <header class="flex items-center gap-3 mb-5 pb-4">
            <span class="shrink-0">
              {g.brand ? <BrandIcon name={g.brand as BrandKey} size={26} /> : <Octicon name={g.octicon as any} size={26} class="text-muted" />}
            </span>
            <div class="min-w-0">
              <h3 class="font-semibold tracking-tight">{g.title}</h3>
              <p class="text-sm text-muted">{g.description}</p>
            </div>
            <span class="ml-auto shrink-0 font-mono text-xs text-subtle tabular-nums">
              {T.work.count(g.count)}
            </span>
          </header>

          {g.featured.length > 0 && (
            <div class="space-y-5">
              {g.featured.map((project, i) => <FeaturedProject project={project} index={i} lang={lang} />)}
            </div>
          )}

          {(g.secondary.length > 0 || g.repos.length > 0) && (
            <div class:list={['grid grid-cols-1 gap-3 sm:grid-cols-2', ![2, 4].includes(g.secondary.length + g.repos.length) && 'lg:grid-cols-3', g.featured.length > 0 && 'mt-5']}>
              {g.secondary.map((p) => <ProjectCard project={p} lang={lang} />)}
              {g.repos.map((r) => <RepoCard repo={r} lang={lang} />)}
            </div>
          )}
        </div>
      ))}
    </div>
  </Section>

  <!-- ===================== EDUCATION ===================== -->
  <Section id="education" eyebrow={T.education.eyebrow} title={T.education.title}>
    <EducationTimeline entries={education(lang)} lang={lang} />
    <div class="mt-14">
      <Languages languages={languages(lang)} lang={lang} />
    </div>
  </Section>

  <!-- ===================== ACTIVITY ===================== -->
  <Section id="activity" eyebrow={T.activity.eyebrow} title={T.activity.title}>
    <div class:list={['grid gap-3', codeLanguages.length > 0 && 'lg:grid-cols-[minmax(0,1fr)_300px]']}>
      <div class="min-w-0 rounded-2xl bg-surface p-5 sm:p-6">
        <ContributionGraph days={contrib.days} total={contrib.total} lang={lang} />
      </div>
      {codeLanguages.length > 0 && (
        <div class="rounded-2xl bg-surface p-5 sm:p-6">
          <CodeLanguages languages={codeLanguages} lang={lang} />
        </div>
      )}
    </div>
  </Section>

  <!-- ===================== OPEN SOURCE ===================== -->
  {prGroups.length > 0 && (
    <Section id="open-source" eyebrow={T.upstream.eyebrow} title={T.upstream.title} lead={T.upstream.lead}>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {prGroups.map(([repo, list]) => (
          <div class="rounded-2xl bg-surface p-5">
            <div class="flex items-center justify-between gap-3">
              <a href={list[0].repoUrl} target="_blank" rel="noopener" class="flex items-center gap-2.5 min-w-0 font-mono text-sm text-fg hover:text-accent transition-colors">
                {list[0].avatar ? (
                  <img src={list[0].avatar} alt="" width="24" height="24" loading="lazy" class="size-6 shrink-0 rounded-md" />
                ) : (
                  <Octicon name="repo" size={20} class="shrink-0 text-subtle" />
                )}
                <span class="truncate">{repo}</span>
                <BrandIcon name={list[0].host === 'gitlab' ? 'siGitlab' : 'siGithub'} size={13} class="shrink-0 opacity-70" />
              </a>
              <span class="shrink-0 inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full bg-merged/12 text-merged"><Octicon name="git-merge" size={12} /> {T.upstream.merged(list.length)}</span>
            </div>
            <ul class="mt-3 space-y-1.5">
              {list.slice(0, 4).map((pr) => (
                <li>
                  <a href={pr.url} target="_blank" rel="noopener" class="flex gap-2 text-sm text-muted hover:text-fg transition-colors">
                    <Octicon name="git-merge" size={14} class="shrink-0 mt-0.5 text-merged/80" />
                    <span class="line-clamp-1">{pr.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="mx-auto max-w-5xl px-4 sm:px-6 pt-24 scroll-mt-14">
    <div class="relative overflow-hidden rounded-2xl bg-surface px-6 py-14 sm:px-12 text-center">
      <div class="relative">
        <p class="font-mono text-xs text-accent uppercase tracking-[0.14em] mb-3">{T.contact.eyebrow}</p>
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-balance">{T.contact.title}</h2>
        <p class="mt-4 text-muted max-w-lg mx-auto">{T.contact.lead}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <CopyEmail primary lang={lang} />
          <a href={SOCIALS[2].url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 h-10 px-4 rounded-lg bg-surface-2 text-sm hover:bg-border transition-colors">
            <Icon name="linkedin" size={15} /> LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

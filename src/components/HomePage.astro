---
/* The home page as a run of full-bleed bands: the hero, my flagship libraries and their reference app, a calm
   part with the rest of my work, other developers' apps in their own band, headed "Not my apps", then
   education, activity, upstream contributions and contact. Numbers are fetched at build time. */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Symbol from './Symbol.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import Mark from './Mark.astro';
import Sparkline from './Sparkline.astro';
import LibraryBand from './LibraryBand.astro';
import AppGallery from './AppGallery.astro';
import Lightbox from './Lightbox.astro';
import ContributionGraph from './ContributionGraph.astro';
import CodeLanguages from './CodeLanguages.astro';
import CopyEmail from './CopyEmail.astro';
import EducationTimeline from './EducationTimeline.astro';
import Languages from './Languages.astro';
import { SITE, SOCIALS, education, languages } from '../lib/site';
import { getProjects } from '../lib/projects';
import { ISLANDS, MIN_STARS, OTHER_USED_BY, USED_BY_LIST, appIcon, islandMembers } from '../lib/islands';
import { OWN_SHOTS, type GalleryApp, type LightboxShot } from '../lib/showcase';
import { t, localePath, type Lang } from '../lib/i18n';
import {
  getRepos,
  getRepo,
  getPackage,
  getPackages,
  getContributions,
  getUpstreamPRs,
  getResolvedIssues,
  getCodeLanguages,
  getExternalRepo,
  compact,
} from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const H = T.home;
const fmt = (n: number) => n.toLocaleString(T.locale);
const caseStudy = (id: string) => localePath(lang, `/projects/${id}`);

const HIDDEN_REPOS = new Set([SITE.handle, 'my-portfolio', 'svg-icons']);

const projects = await getProjects(lang);
const byId = (id: string) => projects.find((p) => p.id === id);

const [repos, packages, contrib, prs, resolvedIssues, codeLanguages] = await Promise.all([
  getRepos(),
  getPackages(),
  getContributions(),
  getUpstreamPRs(),
  getResolvedIssues(),
  getCodeLanguages(),
]);

/* ---------- hero figures ---------- */
const own = repos.filter((r) => !r.fork && !r.archived && !HIDDEN_REPOS.has(r.name));
const totalStars = own.reduce((s, r) => s + r.stargazers_count, 0);
const downloads30d = packages.reduce((s, p) => s + p.downloads30d, 0);
const totalLikes = packages.reduce((s, p) => s + p.likes, 0);
const stats: { n: string; unit?: string; label: string; href: string; icon: string }[] = [
  { n: compact(downloads30d), unit: H.stats.per30, label: H.stats.downloads, href: SOCIALS[1].url, icon: 'download' },
  { n: fmt(totalStars), label: H.stats.stars, href: 'https://github.com/ales-drnz?tab=repositories&sort=stargazers', icon: 'star' },
  { n: fmt(totalLikes), label: H.stats.likes, href: SOCIALS[1].url, icon: 'thumb_up' },
  { n: fmt(prs.length), label: H.stats.prs, href: '#open-source', icon: 'merge' },
  {
    n: fmt(resolvedIssues),
    label: H.stats.issues,
    href: 'https://github.com/issues?q=user%3Aales-drnz+type%3Aissue+is%3Aclosed+reason%3Acompleted+-author%3Aales-drnz',
    icon: 'task_alt',
  },
];

/* ---------- my work: library bands, their reference apps, then the rest ---------- */
const members = islandMembers();
const bands = await Promise.all(
  projects
    .filter((p) => ISLANDS[p.id])
    .map(async (project) => {
      const island = ISLANDS[project.id];
      const app = island.app ? byId(island.app) : undefined;
      const [repo, pkg, appRepo] = await Promise.all([
        project.data.repo ? getRepo(project.data.repo) : undefined,
        project.data.package ? getPackage(project.data.package) : null,
        app?.data.repo ? getRepo(app.data.repo) : undefined,
      ]);
      const builtOn = island.builtOn.map((n) => repos.find((r) => r.name === n)).filter((r) => r !== undefined);
      return { project, island, repo, pkg, app, appRepo, builtOn };
    }),
);
const rest = projects.filter((p) => !ISLANDS[p.id] && !members.projects.has(p.id));
const libs = await Promise.all(
  rest
    .filter((p) => p.data.package)
    .map(async (p) => ({ p, pkg: await getPackage(p.data.package!) })),
);
// the tool cards show only name and tagline, so they need no GitHub data
const tools = rest.filter((p) => !p.data.package).map((p) => ({ p }));
// anything public on GitHub that no section covers yet
const covered = new Set([...projects.flatMap((p) => [p.data.repo, ...p.data.alsoCovers]), ...members.repos].filter(Boolean));
const moreRepos = own.filter((r) => !covered.has(r.name)).sort((a, b) => b.stargazers_count - a.stargazers_count);

const studioBand = bands.find((b) => b.app);
const studio = studioBand?.app;
const studioShots = studio ? (OWN_SHOTS[studio.id] ?? []) : [];
const studioPoster = studio?.data.cover ? await getImage({ src: studio.data.cover, width: 1400, format: 'webp' }) : null;

/* ---------- other developers' apps ---------- */
const deps = Object.entries(ISLANDS).flatMap(([id, island]) => island.usedBy.map((u) => ({ ...u, pkg: byId(id)?.data.package ?? id })));
const live = await Promise.all(deps.map((d) => getExternalRepo(d.repo)));
const withStars = deps.map((d, i) => ({ ...d, live: live[i]?.stargazers_count ?? d.stars }));
const topOf = new Map<string, string>();
for (const d of [...withStars].sort((a, b) => b.live - a.live)) if (!topOf.has(d.pkg)) topOf.set(d.pkg, d.repo);
// the threshold uses the stars written in islands.ts, so a rebuild never drops a card over a few stars
const inGallery = withStars.filter((d) => d.stars >= MIN_STARS && d.shots?.length).sort((a, b) => b.live - a.live);
// everything that gets no card in the gallery, as an icon grid under it
const others = withStars.filter((d) => !inGallery.includes(d)).sort((a, b) => b.live - a.live || a.repo.localeCompare(b.repo));
const perPackage = [
  ...Object.entries(ISLANDS).map(([id, island]) => ({ pkg: byId(id)?.data.package ?? id, count: island.usedBy.length })),
  ...OTHER_USED_BY,
];
const totalApps = perPackage.reduce((s, p) => s + p.count, 0);
const starsBetween = withStars.reduce((s, d) => s + d.live, 0);
// packages without an island are only counted, not listed one by one
const jellyfinCount = OTHER_USED_BY.reduce((s, p) => s + p.count, 0);
// each package's own logo on its figure, from its case study
const logoOf = (pkg: string) => projects.find((p) => p.data.package === pkg)?.data.logo;

const kindOf = (src: ImageMetadata): GalleryApp['kind'] => (src.height > src.width ? 'phone' : src.width / src.height >= 1.9 ? 'wide' : 'desk');
const view = (alt: string) => alt.slice(alt.indexOf(': ') + 2);

/* ---------- lightbox sets: every app's screens in gallery order, and each of my projects ---------- */
const big = (src: ImageMetadata) =>
  getImage({ src, width: Math.min(src.width, src.height > src.width ? 1000 : 2000), format: 'webp' }).then((i) => i.src);

const apps: GalleryApp[] = [];
const appSets: Record<string, LightboxShot[]> = {};
for (const d of inGallery) {
  const shots = d.shots!.map((s) => ({ src: s.src, alt: s.alt[lang] }));
  apps.push({
    repo: d.repo,
    name: d.name ?? d.repo,
    stars: d.live,
    pkg: d.pkg,
    note: d.note?.[lang] ?? '',
    kind: kindOf(shots[0].src),
    framed: !!d.framed,
    shots,
    lbSet: `app:${d.repo}`,
    top: topOf.get(d.pkg) === d.repo,
  });
  const srcs = await Promise.all(shots.map((s) => big(s.src)));
  appSets[`app:${d.repo}`] = shots.map((s, i) => ({
      src: srcs[i],
      portrait: s.src.height > s.src.width,
      framed: !!d.framed,
      alt: s.alt,
      view: view(s.alt),
      name: d.name ?? d.repo,
      href: `https://github.com/${d.repo}`,
      link: d.repo,
      stars: fmt(d.live),
      note: [d.note?.[lang], H.showcase.uses(d.pkg)].filter(Boolean).join(' · '),
      i: i + 1,
      n: shots.length,
  }));
}

const sets: Record<string, LightboxShot[]> = { ...appSets };
for (const [id, shots] of Object.entries(OWN_SHOTS)) {
  const p = byId(id);
  if (!p) continue;
  const repo = p.data.repo ? await getRepo(p.data.repo) : undefined;
  sets[id] = await Promise.all(
    shots.map(async (s, i) => ({
      src: await big(s.src),
      dark: s.dark ? await big(s.dark) : undefined,
      portrait: s.src.height > s.src.width,
      framed: false,
      alt: `${p.data.title}: ${s.view[lang]}`,
      view: s.view[lang],
      name: p.data.title,
      href: caseStudy(p.id),
      link: H.caseStudy,
      stars: repo ? fmt(repo.stargazers_count) : undefined,
      note: p.data.tagline,
      i: i + 1,
      n: shots.length,
    })),
  );
}

/* ---------- upstream PRs, grouped by repository ---------- */
const prGroups = Object.entries(prs.reduce<Record<string, typeof prs>>((acc, pr) => ((acc[pr.repo] ??= []).push(pr), acc), {})).sort(
  (a, b) => b[1].length - a[1].length,
);
---

<Base lang={lang}>
  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <!-- the first screen: who, headline, links and figures, centred in the room under the header -->
      <div class="hero-intro">
      <p class="hero-who"><Mark size={28} disc class="rounded-full" /> {H.who}</p>
      <h1 id="hero-title" class="display-1 hero-title" set:html={H.headline} />
      <p class="lede hero-sub">{H.sub}</p>
      <div class="hero-cta">
        <CopyEmail primary lang={lang} />
        <a class="btn btn-ghost" href={SOCIALS[0].url} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
        <a class="btn btn-ghost" href={SOCIALS[1].url} target="_blank" rel="noopener"><Icon name="pubdev" size={16} /> pub.dev</a>
      </div>

      <dl class="statline">
        {stats.map((s) => (
          <div class="stat">
            <dt class="fig-l">
              <a href={s.href} target={s.href.startsWith('#') ? undefined : '_blank'} rel={s.href.startsWith('#') ? undefined : 'noopener'}>{s.label}</a>
            </dt>
            <dd class="fig-n"><Symbol name={s.icon} fill size={32} trim class="fig-i" />{s.n}{s.unit && <small>{s.unit}</small>}</dd>
          </div>
        ))}
      </dl>
      </div>
    </div>
  </section>

  <!-- ===================== MY WORK: library bands and the reference app ===================== -->
  {bands.map((b, i) => (
    <Fragment>
      <LibraryBand
        id={i === 0 ? 'work' : undefined}
        project={b.project}
        island={b.island}
        repo={b.repo}
        pkg={b.pkg}
        builtOn={b.builtOn}
        shots={OWN_SHOTS[b.project.id] ?? []}
        reverse={i % 2 === 1}
        surface
        lang={lang}
      />
      {b === studioBand && studio && studioShots.length >= 3 && (
        <section class="studio" aria-labelledby="band-studio">
          <div class="wrap">
            <p class="eyebrow"><b>{H.mine}</b> · {H.refApp(b.project.data.title)}</p>
            <h2 id="band-studio" class="display-2 studio-title">
              {studio.data.logo && <Image src={studio.data.logo} alt="" width={80} height={80} densities={[1, 2, 3]} class="studio-logo" />}
              <span>{studio.data.title}</span>
            </h2>
            <p class="lede studio-lede">{studio.data.tagline}</p>
            <p class="studio-platforms">
              {studio.data.platforms.map((pl) => <span>{pl}</span>)}
              {b.appRepo && <span class="star-n"><Symbol name="star" fill size={14} /> {fmt(b.appRepo.stargazers_count)}</span>}
            </p>
            <figure class="comp studio-comp" style="aspect-ratio: 16 / 8.4">
              <button type="button" class="shot" data-lb={studio.id} data-lb-at="2" aria-label={`${studio.data.title}: ${studioShots[2].view[lang]}`} style={`right:0;top:0;width:42%;aspect-ratio:${studioShots[2].src.width} / ${studioShots[2].src.height};z-index:1`}>
                <Image src={studioShots[2].src} alt={`${studio.data.title}: ${studioShots[2].view[lang]}`} widths={[480, 800, 1200]} sizes="(min-width: 1344px) 470px, 42vw" />
              </button>
              <button type="button" class="shot" data-lb={studio.id} data-lb-at="1" aria-label={`${studio.data.title}: ${studioShots[1].view[lang]}`} style={`left:0;top:39%;width:42%;aspect-ratio:${studioShots[1].src.width} / ${studioShots[1].src.height};z-index:2`}>
                <Image src={studioShots[1].src} alt={`${studio.data.title}: ${studioShots[1].view[lang]}`} widths={[480, 800, 1200]} sizes="(min-width: 1344px) 470px, 42vw" />
              </button>
              <button type="button" class="shot" data-lb={studio.id} data-lb-at="0" aria-label={`${studio.data.title}: ${studioShots[0].view[lang]}`} style={`left:21%;top:14%;width:58%;aspect-ratio:${studioShots[0].src.width} / ${studioShots[0].src.height};z-index:3`}>
                {studio.data.coverVideo && studioPoster ? (
                  <video src={studio.data.coverVideo} poster={studioPoster.src} muted loop playsinline preload="none" data-autoplay aria-label={studio.data.coverAlt} />
                ) : (
                  <Image src={studioShots[0].src} alt={`${studio.data.title}: ${studioShots[0].view[lang]}`} widths={[640, 960, 1400]} sizes="(min-width: 1344px) 640px, 58vw" />
                )}
              </button>
            </figure>
            <p class="studio-actions">
              <a class="btn btn-primary" href={caseStudy(studio.id)}>{H.caseStudy} <Symbol name="arrow_forward" size={18} /></a>
              <button type="button" class="btn btn-ghost" data-lb={studio.id} data-lb-at="0"><Symbol name="photo_library" size={18} /> {H.viewScreens(studioShots.length)}</button>
              {studio.data.repo && <a class="btn btn-ghost" href={`https://github.com/ales-drnz/${studio.data.repo}`} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>}
            </p>
          </div>
        </section>
      )}
    </Fragment>
  ))}

  <!-- ===================== MY WORK: the calm part ===================== -->
  {(libs.length > 0 || tools.length > 0) && (
    <section id="more" class="calm" aria-labelledby="more-title">
      <div class="wrap">
        <p class="eyebrow"><b>{H.mine}</b> · {H.alsoMine}</p>
        <h2 id="more-title" class="title-3 calm-title">{H.more}</h2>

        {libs.length > 0 && (
          <ul class="libs">
            {libs.map(({ p, pkg }) => (
              <li>
                <a class="lib-row" href={caseStudy(p.id)}>
                  {p.data.logo && <Image src={p.data.logo} alt="" width={40} height={40} densities={[1, 2, 3]} class="lib-row-logo" />}
                  <span class="lib-row-main">
                    <span class="lib-row-name">{p.data.title}{pkg?.version && <span>v{pkg.version}</span>}</span>
                    <span class="lib-row-tag">{p.data.tagline} {pkg && `${H.likesN(pkg.likes)}.`}</span>
                  </span>
                  {pkg && (
                    <span class="lib-row-dl">
                      {pkg.weekly.length > 4 && <Sparkline values={pkg.weekly.slice(-26)} width={72} height={28} label={T.project.weekly} class="lib-row-spark" />}
                      <span><b>{compact(pkg.downloads30d)}</b><small>{H.stats.per30}</small></span>
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}

        {tools.length > 0 && (
          <div class="tools">
            {tools.map(({ p }) => {
              const s = OWN_SHOTS[p.id]?.[0];
              const cover = s?.src ?? p.data.cover;
              return (
                <article class="tool">
                  {cover && (
                    <button type="button" class="tool-pic" data-lb={s ? p.id : undefined} data-lb-at="0" aria-label={H.openScreens(p.data.title)}>
                      <Image src={cover} alt={p.data.coverAlt ?? p.data.title} widths={[480, 800, 1200]} sizes="(min-width: 1344px) 420px, (min-width: 768px) 31vw, 92vw" class:list={[s?.dark && 'dark:hidden']} />
                      {s?.dark && <Image src={s.dark} alt={p.data.coverAlt ?? p.data.title} widths={[480, 800, 1200]} sizes="(min-width: 1344px) 420px, (min-width: 768px) 31vw, 92vw" class="hidden dark:block" />}
                    </button>
                  )}
                  <div class="tool-head">
                    {p.data.logo && <Image src={p.data.logo} alt="" width={44} height={44} densities={[1, 2, 3]} class="tool-logo" />}
                    <div class="tool-titles">
                      <h3 class="tool-name"><a href={caseStudy(p.id)}>{p.data.title}</a></h3>
                      <p class="tool-tag">{p.data.tagline}</p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}

        {moreRepos.length > 0 && (
          <div class="more-repos">
            <p class="eyebrow">{H.alsoOnGitHub}</p>
            <ul>
              {moreRepos.map((r) => (
                <li>
                  <a href={r.html_url} target="_blank" rel="noopener">{r.name}</a>
                  <span>{[r.description, r.language].filter(Boolean).join(' · ')} <span class="star-n"><Symbol name="star" fill size={13} /> {r.stargazers_count}</span></span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ===================== OTHERS' APPS (not mine) ===================== -->
  {apps.length > 0 && (
    <section id="built-with" class="showcase" aria-labelledby="showcase-title">
      <div class="wrap showcase-head">
        <p class="eyebrow"><b>{H.showcase.notMine}</b> · {H.showcase.madeBy}</p>
        <h2 id="showcase-title" class="display-2 showcase-title">{H.showcase.title}</h2>
        <p class="lede showcase-lede">{H.showcase.lede}</p>
        <dl class="statline">
          <div class="stat"><dt class="fig-l">{H.showcase.depend}</dt><dd class="fig-n"><Symbol name="apps" fill size={32} trim class="fig-i" />{fmt(totalApps)}</dd></div>
          {perPackage.map((p) => (
            <div class="stat"><dt class="fig-l">{H.showcase.on(p.pkg)}</dt><dd class="fig-n">
                {logoOf(p.pkg) ? (
                  <Image src={logoOf(p.pkg)!} alt="" width={40} height={40} densities={[1, 2]} class="fig-logo" />
                ) : (
                  <Symbol name="deployed_code" fill size={32} trim class="fig-i" />
                )}
                {fmt(p.count)}
              </dd></div>
          ))}
          <div class="stat"><dt class="fig-l">{H.showcase.starsBetween}</dt><dd class="fig-n"><Symbol name="star" fill size={32} trim class="fig-i" />{compact(starsBetween)}</dd></div>
        </dl>
      </div>

      <AppGallery apps={apps} lang={lang} />

      <!-- the rest: no screenshots, so each app shows its own icon (or its owner's avatar) -->
      <div class="wrap others">
        <h3 class="title-3 others-title">{H.showcase.others(others.length + jellyfinCount)}</h3>
        <p class="others-lede">{H.showcase.othersLede}</p>
        <ul class="others-grid">
          {others.map((d) => {
            const icon = appIcon(d.repo);
            const [owner, name] = d.repo.split('/');
            return (
              <li>
                <a class="other" href={`https://github.com/${d.repo}`} target="_blank" rel="noopener">
                  {icon ? (
                    <Image src={icon} alt="" width={48} height={48} densities={[1, 2, 3]} class="other-icon" loading="lazy" />
                  ) : (
                    <img src={`https://avatars.githubusercontent.com/${owner}?s=96`} alt="" width="48" height="48" loading="lazy" class="other-icon is-avatar" />
                  )}
                  <span class="other-main">
                    <span class="other-name">{name}</span>
                    <span class="other-meta">{owner}</span>
                  </span>
                  <span class="other-side">
                    {d.live > 0 && <span class="star-n"><Symbol name="star" fill size={13} /> {fmt(d.live)}</span>}
                    <span>{d.pkg}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="others-foot">
          {jellyfinCount > 0 && <span>{H.showcase.jellyfin(jellyfinCount)}</span>}
          <a class="btn btn-ghost" href={USED_BY_LIST} target="_blank" rel="noopener"><Icon name="github" size={16} /> {H.showcase.all(totalApps)}</a>
        </p>
      </div>
    </section>
  )}

  <!-- ===================== EDUCATION ===================== -->
  <section id="education" class="sec" aria-labelledby="education-title">
    <div class="wrap sec-grid">
      <header class="sec-head">
        <p class="eyebrow">{T.education.eyebrow}</p>
        <h2 id="education-title" class="title-3">{T.education.title}</h2>
      </header>
      <div class="sec-body">
        <EducationTimeline entries={education(lang)} lang={lang} />
        <div class="sec-after">
          <Languages languages={languages(lang)} lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== ACTIVITY ===================== -->
  <section id="activity" class="sec" aria-labelledby="activity-title">
    <div class="wrap sec-grid">
      <header class="sec-head">
        <p class="eyebrow">{T.activity.eyebrow}</p>
        <h2 id="activity-title" class="title-3">{T.activity.title}</h2>
        <p class="sec-lead">{T.activity.lead}</p>
      </header>
      <div class="sec-body activity-graph">
        <ContributionGraph days={contrib.days} total={contrib.total} lang={lang} />
      </div>
      {codeLanguages.length > 0 && (
        <div class="activity-pie">
          <CodeLanguages languages={codeLanguages} lang={lang} />
        </div>
      )}
    </div>
  </section>

  <!-- ===================== UPSTREAM ===================== -->
  {prGroups.length > 0 && (
    <section id="open-source" class="sec" aria-labelledby="open-source-title">
      <div class="wrap sec-grid">
        <header class="sec-head">
          <p class="eyebrow">{T.upstream.eyebrow}</p>
          <h2 id="open-source-title" class="title-3">{T.upstream.title}</h2>
          <p class="sec-lead">{T.upstream.lead}</p>
        </header>
        <div class="sec-body prs">
          {prGroups.map(([repo, list]) => (
            <div class="pr">
              <p class="pr-repo">
                <a href={list[0].repoUrl} target="_blank" rel="noopener">
                  {list[0].avatar && <img src={list[0].avatar} alt="" width="20" height="20" loading="lazy" />}
                  <span>{repo}</span>
                  <BrandIcon name={list[0].host === 'gitlab' ? 'siGitlab' : 'siGithub'} size={12} class="pr-host" />
                </a>
                <span class="pr-count">{T.upstream.merged(list.length)}</span>
              </p>
              <ul>
                {list.slice(0, 4).map((pr) => (
                  <li>
                    <a href={pr.url} target="_blank" rel="noopener"><Symbol name="merge" size={16} class="pr-icon" /> <span>{pr.title}</span></a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="contact-inner">
        <p class="eyebrow">{T.contact.eyebrow}</p>
        <h2 id="contact-title" class="display-1 contact-title">{T.contact.title}</h2>
        <p class="lede contact-lede">{T.contact.lead}</p>
        <div class="contact-cta">
          <CopyEmail primary lang={lang} />
          <a class="btn btn-ghost" href={SOCIALS[2].url} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <Lightbox sets={sets} lang={lang} />
</Base>

<style>
  /* ---------- hero ---------- */
  /* the hero is the first screen only: the mpv_audio_kit band follows straight after it */
  .hero {
    text-align: center;
  }
  /* the header is 56px tall and sticky; svh so a phone's collapsing toolbar does not make it jump */
  /* the whole first screen, figures included, fits under the header on any screen: type and spacing follow
     the height as well as the width (svh), so a short laptop window or a phone shrinks them too */
  .hero-intro {
    min-height: calc(100svh - 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(16px, 4svh, 64px);
  }
  .hero-intro .statline {
    align-self: stretch;
  }
  .hero-who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 14px;
    color: var(--c-muted);
  }
  .hero-title {
    max-width: 13ch;
    margin: clamp(10px, 2.4svh, 32px) auto 0;
    font-size: clamp(34px, min(7.6vw, 10.5svh), 112px);
  }
  .hero-sub {
    max-width: 42ch;
    margin: clamp(10px, 2.4svh, 32px) auto 0;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(14px, 3.4svh, 48px);
  }
  .hero-intro .statline {
    margin-top: clamp(16px, 4.6svh, 64px);
  }
  .statline {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: var(--s-5) 0 0;
    border-top: 1px solid var(--c-border);
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: var(--s-3) var(--s-1) 0;
  }
  .stat + .stat {
    border-left: 1px solid var(--c-border);
  }
  .stat dd {
    margin: 0;
  }
  .stat a:hover {
    color: var(--c-fg);
  }
  @media (max-width: 767px) {
    .statline {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat {
      padding: var(--s-3) var(--s-1);
    }
    .stat:first-child {
      grid-column: 1 / -1;
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--c-border);
    }
    .stat:nth-child(odd):not(:first-child) {
      border-left: 1px solid var(--c-border);
    }
  }
  /* on a phone the hero's five figures are a compact 3 + 2 grid, not five stacked rows */
  @media (max-width: 767px) {
    .hero-sub {
      font-size: 16px;
    }
    .hero-cta :global(.btn) {
      height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }
    .hero-intro .statline {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 4px;
    }
    .hero-intro .stat {
      grid-column: span 2;
      padding: 10px 2px 0;
      border: 0;
    }
    .hero-intro .stat:nth-child(n + 4) {
      grid-column: span 3;
    }
    .hero-intro .fig-n {
      font-size: clamp(22px, 6.6vw, 30px);
    }
    .hero-intro .fig-l {
      font-size: 12px;
    }
  }
  /* ---------- MPV Studio, centred ---------- */
  .studio {
    padding-block: var(--band);
    text-align: center;
  }
  /* the app icon beside the name, as on the library bands */
  .studio-title {
    display: flex;

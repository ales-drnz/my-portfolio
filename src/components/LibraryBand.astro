---
/* One of my flagship libraries as a full-bleed band: the copy (name, tagline, figures, downloads chart, the repo
   that builds its native library) beside a floating composition of its diagrams. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import DownloadsChart from './DownloadsChart.astro';
import Symbol from './Symbol.astro';
import type { Island } from '../lib/islands';
import type { OwnShot } from '../lib/showcase';
import { compact, type PubPackage, type Repo } from '../lib/data';
import { t, localePath, type Lang } from '../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  island: Island;
  repo?: Repo;
  pkg: PubPackage | null;
  builtOn: Repo[];
  /** the two screens of the composition: [back, front] by position, from OWN_SHOTS */
  shots: OwnShot[];
  /** media on the left, copy on the right */
  reverse?: boolean;
  /** a filled ground instead of the page's */
  surface?: boolean;
  id?: string;
  lang: Lang;
}

const { project, island, repo, pkg, builtOn, shots, reverse = false, surface = false, id, lang } = Astro.props;
const T = t(lang).home;
const p = project.data;
const fmt = (n: number) => n.toLocaleString(t(lang).locale);
const headingId = `band-${project.id}`;

// the composition: the first screen large at the top, the second smaller and overlapping it lower down.
// Sizes are in units of the box width; the box is as tall as the two need, with no empty margin.
const [a, b] = shots;
const ar = (s: OwnShot) => s.src.width / s.src.height;
const A = { w: reverse ? 0.86 : 0.88 };
const B = { w: reverse ? 0.7 : 0.72 };
const aH = A.w / ar(a);
const bTop = aH * (reverse ? 0.86 : 0.82);
const boxH = Math.max(aH, bTop + B.w / ar(b));
const pct = (v: number) => `${((v / boxH) * 100).toFixed(2)}%`;
---

<section id={id} class:list={['lib-band', surface && 'lib-surface', reverse && 'lib-rev']} aria-labelledby={headingId}>
  <div class="wrap lib-grid">
    <div class="lib-copy">
      <div class="lib-head">
        {p.logo && <Image src={p.logo} alt="" width={48} height={48} densities={[1, 2, 3]} class="lib-logo" />}
        <p class="eyebrow"><b>{T.mine}</b> · {T.library} · pub.dev</p>
      </div>
      <h2 id={headingId} class="display-3 lib-title">{p.title}</h2>
      <p class="lede lib-lede">{p.tagline}</p>
      <p class="lib-tags">
        {p.stack.slice(0, 5).map((s) => <span>{s}</span>)}
        {pkg?.version && <span>v{pkg.version}</span>}
      </p>

      <dl class="lib-figs">
        <div><dt class="fig-l">{T.downloads30}</dt><dd class="fig-n">{pkg ? compact(pkg.downloads30d) : '—'}</dd></div>
        <div><dt class="fig-l">{T.stars}</dt><dd class="fig-n">{repo ? fmt(repo.stargazers_count) : '—'}</dd></div>
        <div><dt class="fig-l">{T.likes}</dt><dd class="fig-n">{pkg ? fmt(pkg.likes) : '—'}</dd></div>
      </dl>

      {pkg && <DownloadsChart weekly={pkg.weekly} lang={lang} class="lib-chart" />}

      {builtOn.length > 0 && (
        <dl class="lib-also">
          {builtOn.map((r) => (
            <div>
              <dt>{T.native}</dt>
              <dd>
                <a href={r.html_url} target="_blank" rel="noopener" class="lib-repo">{r.name}</a>
                <span class="lib-repo-meta star-n">{r.language && `${r.language} · `}<Symbol name="star" fill size={13} /> {r.stargazers_count}</span>
                <p>{island.buildNote[lang]}</p>
              </dd>
            </div>
          ))}
        </dl>
      )}

      <p class="lib-actions">
        <a class="link-accent" href={localePath(lang, `/projects/${project.id}`)}>{T.caseStudy} →</a>
        {p.package && <a class="lib-muted" href={`https://pub.dev/packages/${p.package}`} target="_blank" rel="noopener">pub.dev</a>}
        {p.repo && <a class="lib-muted" href={`https://github.com/ales-drnz/${p.repo}`} target="_blank" rel="noopener">GitHub</a>}
      </p>
    </div>

    <figure class="comp lib-media" style={`aspect-ratio:1 / ${boxH.toFixed(4)}`}>
      <button
        type="button"
        class="shot"
        data-lb={project.id}
        data-lb-at="0"
        aria-label={`${p.title}: ${a.view[lang]}`}
        style={`${reverse ? 'right' : 'left'}:0;top:0;width:${A.w * 100}%;aspect-ratio:${a.src.width} / ${a.src.height};z-index:1`}
      >
        <Image src={a.src} alt={`${p.title}: ${a.view[lang]}`} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 40vw, 92vw" />
      </button>
      <button
        type="button"
        class="shot"
        data-lb={project.id}
        data-lb-at="1"
        aria-label={`${p.title}: ${b.view[lang]}`}
        style={`${reverse ? 'left' : 'right'}:0;top:${pct(bTop)};width:${B.w * 100}%;aspect-ratio:${b.src.width} / ${b.src.height};z-index:2`}
      >
        <Image src={b.src} alt={`${p.title}: ${b.view[lang]}`} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 32vw, 72vw" />
      </button>
    </figure>
  </div>
</section>

<style>
  .lib-band {
    position: relative;
    padding-block: var(--band);
    scroll-margin-top: 56px;
  }
  .lib-surface {
    background: var(--c-surface);
  }
  :global([data-theme='light']) .lib-surface {
    background: var(--c-surface-2);
  }
  .lib-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-5);
  }
  @media (min-width: 768px) {
    .lib-copy {
      max-width: 36rem;
    }
  }
  @media (min-width: 1024px) {
    .lib-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: center;
    }
    .lib-copy {
      grid-column: 1 / span 5;
      max-width: none;
    }
    .lib-media {
      grid-column: 7 / span 6;
    }
    .lib-rev .lib-copy {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .lib-rev .lib-media {
      grid-column: 1 / span 6;
      grid-row: 1;
    }
  }
  .lib-head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .lib-head :global(.lib-logo) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: contain;
    flex: none;
  }
  .lib-title {
    margin-top: var(--s-3);
    overflow-wrap: anywhere;
  }
  .lib-lede {
    margin-top: var(--s-2);
    max-width: 30ch;
  }
  .lib-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: var(--s-2) 0 0;
    font: 12px var(--font-mono);
    color: var(--c-subtle);
  }
  .lib-figs {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--s-2) clamp(24px, 3vw, 48px);
    margin: var(--s-4) 0 0;
  }
  .lib-figs div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .lib-figs dd {
    margin: 0;
  }
  .lib-figs dt {
    margin-top: var(--s-1);
  }
  .lib-band :global(.lib-chart) {
    margin-top: var(--s-4);
  }
  .lib-also {
    margin: var(--s-4) 0 0;
  }
  .lib-also > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--c-border);
  }
  .lib-also dt {
    font: 500 11px/1.9 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-subtle);
  }
  .lib-also dd {
    margin: 0;
    font-size: 15px;
  }
  .lib-repo {
    font-weight: 600;
  }
  .lib-repo:hover {
    color: var(--c-accent);
  }
  .lib-repo-meta {
    margin-left: 8px;
    font: 12px var(--font-mono);
    color: var(--c-subtle);
  }
  .lib-also p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .lib-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin: var(--s-3) 0 0;
    font-size: 15px;
  }
  .lib-muted {
    color: var(--c-muted);
  }
  .lib-muted:hover {
    color: var(--c-fg);
  }
  @media (max-width: 479px) {
    .lib-figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-2);
    }
  }
</style>

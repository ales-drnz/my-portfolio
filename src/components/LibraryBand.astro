---
/* One of my flagship libraries as a full-bleed band: the copy (logo and name, tagline, figures, downloads chart,
   the repo that builds its native library, boxed) beside a floating composition of its diagrams. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import DownloadsChart from './DownloadsChart.astro';
import Symbol from './Symbol.astro';
import Icon from './Icon.astro';
import type { Island } from '../lib/islands';
import type { OwnShot } from '../lib/showcase';
import { compact, type PubPackage, type Repo } from '../lib/data';
import { t, localePath, type Lang } from '../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  island: Island;
  repo?: Repo;
  pkg: PubPackage | null;
  builtOn: Repo[];
  /** the two screens of the composition: [back, front] by position, from OWN_SHOTS */
  shots: OwnShot[];
  /** media on the left, copy on the right */
  reverse?: boolean;
  /** a filled ground instead of the page's */
  surface?: boolean;
  id?: string;
  lang: Lang;
}

const { project, island, repo, pkg, builtOn, shots, reverse = false, surface = false, id, lang } = Astro.props;
const T = t(lang).home;
const p = project.data;
const fmt = (n: number) => n.toLocaleString(t(lang).locale);
const headingId = `band-${project.id}`;

// the composition: the first screen large at the top, the second smaller and overlapping it lower down.
// Sizes are in units of the box width; the box is as tall as the two need, with no empty margin.
const [a, b] = shots;
const ar = (s: OwnShot) => s.src.width / s.src.height;
const A = { w: reverse ? 0.86 : 0.88 };
const B = { w: reverse ? 0.7 : 0.72 };
const aH = A.w / ar(a);
const bTop = aH * (reverse ? 0.86 : 0.82);
const boxH = Math.max(aH, bTop + B.w / ar(b));
const pct = (v: number) => `${((v / boxH) * 100).toFixed(2)}%`;
---

<section id={id} class:list={['lib-band', surface && 'lib-surface', reverse && 'lib-rev']} aria-labelledby={headingId}>
  <div class="wrap lib-grid">
    <div class="lib-copy">
      <h2 id={headingId} class="display-3 lib-title">
        {p.logo && <Image src={p.logo} alt="" width={64} height={64} densities={[1, 2, 3]} class="lib-logo" />}
        <span>{p.title}</span>
      </h2>
      <p class="lede lib-lede">{p.tagline}</p>

      <dl class="lib-figs">
        <div><dt class="fig-l">{T.downloads30}</dt><dd class="fig-n"><Symbol name="download" fill size={32} trim class="fig-i" />{pkg ? compact(pkg.downloads30d) : '—'}</dd></div>
        <div><dt class="fig-l">{T.stars}</dt><dd class="fig-n"><Symbol name="star" fill size={32} trim class="fig-i" />{repo ? fmt(repo.stargazers_count) : '—'}</dd></div>
        <div><dt class="fig-l">{T.likes}</dt><dd class="fig-n"><Symbol name="thumb_up" fill size={32} trim class="fig-i" />{pkg ? fmt(pkg.likes) : '—'}</dd></div>
      </dl>

      {pkg && <DownloadsChart weekly={pkg.weekly} lang={lang} class="lib-chart" />}

      {builtOn.length > 0 && (
        <dl class="lib-also">
          {builtOn.map((r) => (
            <div>
              <dt>{T.native}</dt>
              <dd>
                <a href={r.html_url} target="_blank" rel="noopener" class="lib-repo">{r.name}</a>
                <span class="lib-repo-meta star-n">{r.language && `${r.language} · `}<Symbol name="star" fill size={13} /> {r.stargazers_count}</span>
                <p>{island.buildNote[lang]}</p>
              </dd>
            </div>
          ))}
        </dl>
      )}

      <p class="lib-actions">
        <a class="btn btn-primary" href={localePath(lang, `/projects/${project.id}`)}>{T.caseStudy} <Symbol name="arrow_forward" size={18} /></a>
        {p.repo && <a class="btn btn-ghost" href={`https://github.com/ales-drnz/${p.repo}`} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>}
        {p.package && <a class="btn btn-ghost" href={`https://pub.dev/packages/${p.package}`} target="_blank" rel="noopener"><Icon name="pubdev" size={16} /> pub.dev</a>}
      </p>
    </div>

    <figure class="comp lib-media" style={`aspect-ratio:1 / ${boxH.toFixed(4)}`}>
      <button
        type="button"
        class="shot"
        data-lb={project.id}
        data-lb-at="0"
        aria-label={`${p.title}: ${a.view[lang]}`}
        style={`${reverse ? 'right' : 'left'}:0;top:0;width:${A.w * 100}%;aspect-ratio:${a.src.width} / ${a.src.height};z-index:1`}
      >
        <Image src={a.src} alt={`${p.title}: ${a.view[lang]}`} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 40vw, 92vw" />
      </button>
      <button
        type="button"
        class="shot"
        data-lb={project.id}
        data-lb-at="1"
        aria-label={`${p.title}: ${b.view[lang]}`}
        style={`${reverse ? 'left' : 'right'}:0;top:${pct(bTop)};width:${B.w * 100}%;aspect-ratio:${b.src.width} / ${b.src.height};z-index:2`}
      >
        <Image src={b.src} alt={`${p.title}: ${b.view[lang]}`} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 32vw, 72vw" />
      </button>
    </figure>
  </div>
</section>

<style>
  /* a band is one screen under the 56px header, its content centred, so the Work link (or a scroll) shows it
     whole, buttons included. Spacing, title and chart follow the screen height (svh) as well as the width,
     so a short window shrinks them instead of pushing the buttons off. */
  .lib-band {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - 56px);
    padding-block: clamp(20px, 5svh, 128px);
    --gap-y: clamp(10px, 2.4svh, 40px);
  }
  .lib-band > .wrap {
    width: 100%;
  }
  .lib-surface {
    background: var(--c-surface);
  }
  :global([data-theme='light']) .lib-surface {
    background: var(--c-surface-2);
  }
  .lib-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-5);
  }
  @media (min-width: 768px) {
    .lib-copy {
      max-width: 36rem;
    }
  }
  @media (min-width: 1024px) {
    .lib-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: center;
    }
    .lib-copy {
      grid-column: 1 / span 5;
      max-width: none;
    }
    .lib-media {
      grid-column: 7 / span 6;
    }
    .lib-rev .lib-copy {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .lib-rev .lib-media {
      grid-column: 1 / span 6;
      grid-row: 1;
    }
  }
  /* the logo sits beside the name, sized to its cap height */
  .lib-title {
    font-size: clamp(32px, min(4vw, 7.5svh), 58px);
    display: flex;
    align-items: center;
    gap: 0.28em;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .lib-title span {
    min-width: 0;
  }
  .lib-title :global(.lib-logo) {
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    object-fit: contain;
    flex: none;
  }
  .lib-lede {
    margin-top: clamp(6px, 1.4svh, 16px);
    max-width: 30ch;
  }
  .lib-figs {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--s-2) clamp(24px, 3vw, 48px);
    margin: var(--gap-y) 0 0;
  }
  .lib-figs div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .lib-figs dd {
    margin: 0;
  }
  /* the figures shrink with a short screen too */
  .lib-figs .fig-n {
    font-size: clamp(26px, min(3.2vw, 6svh), 46px);
  }
  .lib-figs dt {
    margin-top: var(--s-1);
  }
  .lib-band :global(.lib-chart) {
    margin-top: var(--gap-y);
    --bars-h: clamp(40px, 9svh, 96px);
  }
  .lib-also {
    margin: var(--gap-y) 0 0;
  }
  /* the native build repo in its own box: a separate repo, not part of the package */
  .lib-also > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px var(--s-2);
    padding: clamp(8px, 1.6svh, 16px) var(--s-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-box);
    background: var(--c-bg);
  }
  .lib-also > div + div {
    margin-top: var(--s-1);
  }
  .lib-also dt {
    font: 500 11px/1.9 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-subtle);
  }
  .lib-also dd {
    margin: 0;
    font-size: 15px;
  }
  .lib-repo {
    font-weight: 600;
  }
  .lib-repo:hover {
    color: var(--c-accent);
  }
  .lib-repo-meta {
    margin-left: 8px;
    font: 12px var(--font-mono);
    color: var(--c-subtle);
  }
  .lib-also p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  /* the same pills as the hero's links */
  .lib-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: var(--gap-y) 0 0;
  }
  /* between 1024 and 1279px the copy column is under 410px: a tighter pill keeps the three on one line */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .lib-actions {
      gap: 8px;
    }
    .lib-actions .btn {
      padding: 0 16px;
      font-size: 14px;
    }
  }
  @media (max-width: 479px) {
    .lib-figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-2);
    }
  }
</style>

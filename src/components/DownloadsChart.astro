---
/* Weekly downloads of one package: the last 26 weeks as bars, the last 10 in the accent. The badge compares
   the last 10 weeks with the 10 before; pointing at a bar reads that week out above the chart. */
import { t, type Lang } from '../lib/i18n';

interface Props {
  /** weekly downloads, oldest → newest */
  weekly: number[];
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const T = t(lang).home.chart;
const fmt = (n: number) => n.toLocaleString(t(lang).locale);

const weekly = Astro.props.weekly.slice(-26);
const sum = (a: number[]) => a.reduce((x, y) => x + y, 0);
const growth = weekly.length >= 20 && sum(weekly.slice(-20, -10)) > 0 ? sum(weekly.slice(-10)) / sum(weekly.slice(-20, -10)) : null;
const W = 1000;
const H = 300;
const GAP = 8;
const bw = weekly.length ? (W - GAP * (weekly.length - 1)) / weekly.length : 0;
const wmax = Math.max(1, ...weekly);
const barH = (v: number) => Math.max(4, (v / wmax) * (H - 8));
---

{
  weekly.length > 1 && (
    <figure class:list={['dl-chart', className]} data-chart data-label={T.weekly(weekly.length)}>
      <div class="dl-head">
        <figcaption class="dl-readout" aria-live="polite">{T.weekly(weekly.length)}</figcaption>
        {growth && growth >= 1.2 && (
          <span class="dl-growth" title={T.growth}>
            <b>×{growth.toFixed(1)}</b>
            <span>{T.growth}</span>
          </span>
        )}
      </div>
      <div class="dl-bars">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={T.weekly(weekly.length)}>
          {weekly.map((v, i) => (
            <rect class:list={['bar', i >= weekly.length - 10 && 'hot']} x={i * (bw + GAP)} y={H - barH(v)} width={bw} height={barH(v)} rx="3" />
          ))}
          {weekly.map((v, i) => (
            <rect class="hit" x={i * (bw + GAP) - GAP / 2} y="0" width={bw + GAP} height={H} data-text={T.downloadsIn(T.weeksAgo(weekly.length - 1 - i), fmt(v))} />
          ))}
        </svg>
      </div>
      <div class="dl-axis" aria-hidden="true">
        <span>{T.weeksAgo(weekly.length)}</span>
        <span>{T.peak(fmt(wmax))}</span>
        <span>{T.thisWeek}</span>
      </div>
    </figure>
  )
}

<style>
  .dl-chart {
    margin: 0;
  }
  .dl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 28px;
  }
  .dl-readout {
    font: 12px var(--font-mono);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    min-width: 0;
  }
  .dl-growth {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--c-subtle);
    text-align: right;
  }
  .dl-growth b {
    font: 600 13px/1 var(--font-mono);
    padding: 6px 8px;
    border-radius: 6px;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .dl-growth span {
      display: none;
    }
  }
  .dl-bars {
    position: relative;
    height: 96px;
    margin-top: 12px;
  }
  .dl-bars svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .bar {
    fill: color-mix(in oklab, var(--c-fg) 16%, transparent);
    transition: fill 0.12s;
  }
  .bar.hot {
    fill: var(--c-accent);
  }
  .bar.sel {
    fill: var(--c-fg);
  }
  .hit {
    fill: transparent;
    cursor: crosshair;
  }
  .dl-axis {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--c-border);
    font: 11px var(--font-mono);
    color: var(--c-subtle);
  }
</style>

<script>
  // point at a bar to read that week
  function setup() {
    document.querySelectorAll<HTMLElement>('[data-chart]').forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = '1';
      const out = el.querySelector<HTMLElement>('.dl-readout')!;
      const bars = [...el.querySelectorAll<SVGRectElement>('rect.bar')];
      el.querySelectorAll<SVGRectElement>('rect.hit').forEach((hit, i) => {
        hit.addEventListener('pointerenter', () => {
          bars.forEach((b, j) => b.classList.toggle('sel', j === i));
          out.textContent = hit.dataset.text ?? '';
        });
      });
      el.querySelector('.dl-bars')!.addEventListener('pointerleave', () => {
        bars.forEach((b) => b.classList.remove('sel'));
        out.textContent = el.dataset.label ?? '';
      });
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>

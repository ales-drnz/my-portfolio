---
/* Weekly downloads of one package: the last 26 weeks as bars, the last 10 in the accent. Kept to one label
   and the latest week's count on the right; pointing at a bar reads that week out in place of the label. */
import { t, type Lang } from '../lib/i18n';

interface Props {
  /** weekly downloads, oldest → newest */
  weekly: number[];
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const T = t(lang).home.chart;
const fmt = (n: number) => n.toLocaleString(t(lang).locale);

const weekly = Astro.props.weekly.slice(-26);
const W = 1000;
const H = 300;
const GAP = 8;
const bw = weekly.length ? (W - GAP * (weekly.length - 1)) / weekly.length : 0;
const wmax = Math.max(1, ...weekly);
const barH = (v: number) => Math.max(4, (v / wmax) * (H - 8));
---

{
  weekly.length > 1 && (
    <figure class:list={['dl-chart', className]} data-chart data-label={T.weekly}>
      <div class="dl-head">
        <figcaption class="dl-readout" aria-live="polite">{T.weekly}</figcaption>
        <span class="dl-now">
          {T.weeksAgo(0)} <b>{fmt(weekly[weekly.length - 1])}</b>
        </span>
      </div>
      <div class="dl-bars">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={T.weekly}>
          {weekly.map((v, i) => (
            <rect class:list={['bar', i >= weekly.length - 10 && 'hot']} x={i * (bw + GAP)} y={H - barH(v)} width={bw} height={barH(v)} rx="3" />
          ))}
          {weekly.map((v, i) => (
            <rect class="hit" x={i * (bw + GAP) - GAP / 2} y="0" width={bw + GAP} height={H} data-text={T.downloadsIn(T.weeksAgo(weekly.length - 1 - i), fmt(v))} />
          ))}
        </svg>
      </div>
    </figure>
  )
}

<style>
  .dl-chart {
    margin: 0;
  }
  .dl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 28px;
  }
  .dl-readout {
    font: 12px var(--font-mono);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    min-width: 0;
  }
  .dl-now {
    font: 12px var(--font-mono);
    color: var(--c-muted);
    white-space: nowrap;
  }
  .dl-now b {
    margin-left: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }
  .dl-bars {
    position: relative;
    height: 96px;
    margin-top: 12px;
  }
  .dl-bars svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .bar {
    fill: color-mix(in oklab, var(--c-fg) 16%, transparent);
    transition: fill 0.12s;
  }
  .bar.hot {
    fill: var(--c-accent);
  }
  .bar.sel {
    fill: var(--c-fg);
  }
  .hit {
    fill: transparent;
    cursor: crosshair;
  }
</style>

<script>
  // point at a bar to read that week
  function setup() {
    document.querySelectorAll<HTMLElement>('[data-chart]').forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = '1';
      const out = el.querySelector<HTMLElement>('.dl-readout')!;
      const bars = [...el.querySelectorAll<SVGRectElement>('rect.bar')];
      el.querySelectorAll<SVGRectElement>('rect.hit').forEach((hit, i) => {
        hit.addEventListener('pointerenter', () => {
          bars.forEach((b, j) => b.classList.toggle('sel', j === i));
          out.textContent = hit.dataset.text ?? '';
        });
      });
      el.querySelector('.dl-bars')!.addEventListener('pointerleave', () => {
        bars.forEach((b) => b.classList.remove('sel'));
        out.textContent = el.dataset.label ?? '';
      });
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>

---
/* The full-screen screenshot gallery of the home page. Every opener carries data-lb (a set) and data-lb-at (the
   first screen to show); arrows, ←/→, swipes and the buttons walk the set, Esc or a click outside closes it. */
import Symbol from './Symbol.astro';
import { t, type Lang } from '../lib/i18n';
import type { LightboxShot } from '../lib/showcase';

interface Props {
  sets: Record<string, LightboxShot[]>;
  lang: Lang;
}

const { sets, lang } = Astro.props;
const T = t(lang).home.lightbox;
---

<dialog class="lb" aria-label={T.gallery}>
  <script type="application/json" set:html={JSON.stringify(sets)} />
  <div class="lb-top">
    <div class="lb-title">
      <b class="lb-name"></b>
      <a class="lb-link"><span></span> <Symbol name="arrow_outward" size={14} /></a>
      <span class="lb-stars"><Symbol name="star" fill size={14} class="text-star" /> <span></span></span>
    </div>
    <button type="button" class="lb-btn lb-close" aria-label={T.close}><Symbol name="close" size={22} /></button>
  </div>
  <figure class="lb-stage">
    <img alt="" />
    <figcaption class="lb-cap"><span class="lb-view"></span><span class="lb-count"></span><span class="lb-note"></span></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-nav lb-prev" aria-label={T.prev}><Symbol name="chevron_left" size={28} /></button>
  <button type="button" class="lb-btn lb-nav lb-next" aria-label={T.next}><Symbol name="chevron_right" size={28} /></button>
</dialog>

<style>
  .lb {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-fg);
    overflow: hidden;
  }
  .lb[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  /* opens with a short fade and a 2% settle; closes faster (is-closing, then close() on transitionend,
     since exit transitions of a dialog don't run in Safari) */
  .lb {
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }
  .lb::backdrop {
    transition: opacity var(--dur-2) var(--ease-out);
  }
  @starting-style {
    .lb[open] {
      opacity: 0;
      transform: scale(0.98);
    }
    .lb[open]::backdrop {
      opacity: 0;
    }
  }
  .lb.is-closing {
    opacity: 0;
    transform: scale(0.98);
    transition-duration: 140ms;
    transition-timing-function: var(--ease-in);
  }
  .lb.is-closing::backdrop {
    opacity: 0;
    transition: opacity 140ms var(--ease-in);
  }
  /* ::backdrop does not inherit the theme's custom properties everywhere, so its colours are spelled out */
  .lb::backdrop {
    background: rgb(242 242 239 / 0.95);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  :global([data-theme='dark']) .lb::backdrop {
    background: rgb(23 25 29 / 0.95);
  }
  .lb-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px var(--pad-x);
  }
  .lb-title {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .lb-name {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .lb-link,
  .lb-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font: 12px var(--font-mono);
    color: var(--c-muted);
  }
  .lb-link:hover {
    color: var(--c-accent);
  }
  .lb-nav[hidden],
  .lb-stars[hidden] {
    display: none;
  }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-muted);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .lb-btn:hover {
    color: var(--c-fg);
    background: var(--c-surface-2);
  }
  .lb-stage {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: 16px;
    padding: 0 88px 24px;
  }
  .lb-stage img {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    align-self: center;
    border-radius: var(--r-box);
    box-shadow: 0 0 0 1px var(--c-border), 0 30px 80px -30px rgb(0 0 0 / 0.6);
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .lb-stage img.portrait {
    border-radius: 24px;
    box-shadow: 0 0 0 6px #0c0d10, 0 30px 80px -30px rgb(0 0 0 / 0.6);
    margin: 6px 0;
  }
  .lb-stage img.framed {
    border-radius: 0;
    box-shadow: none;
    margin: 0;
  }
  /* a new picture fades in once it has loaded, rather than showing half-dimmed */
  .lb-stage img.loading {
    opacity: 0;
    transition: none;
  }
  .lb-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    max-width: 70ch;
    text-align: center;
    font-size: 14px;
    color: var(--c-muted);
  }
  .lb-view {
    color: var(--c-fg);
  }
  .lb-count {
    font: 12px var(--font-mono);
    color: var(--c-subtle);
    align-self: center;
  }
  .lb-note {
    flex-basis: 100%;
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
  }
  .lb-prev {
    left: 16px;
  }
  .lb-next {
    right: 16px;
  }
  @media (max-width: 767px) {
    .lb-stage {
      padding: 0 var(--pad-x) 96px;
    }
    .lb-nav {
      top: auto;
      bottom: 24px;
      transform: none;
    }
    .lb-prev {
      left: calc(50% - 64px);
    }
    .lb-next {
      right: calc(50% - 64px);
    }
  }
</style>

<script>
  import type { LightboxShot } from '../lib/showcase';

  let sets: Record<string, LightboxShot[]> = {};
  let set: LightboxShot[] = [];
  let at = 0;
  let dlg: HTMLDialogElement | null = null;
  const dark = () => document.documentElement.dataset.theme === 'dark';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  // close with the exit fade; at once under reduced motion. A timeout covers a transitionend that never comes.
  function closeLb() {
    const d = dlg;
    if (!d?.open || d.classList.contains('is-closing')) return;
    if (reduced.matches) return d.close();
    d.classList.add('is-closing');
    let done = false;
    const onEnd = (e: TransitionEvent) => e.target === d && finish();
    const finish = () => {
      if (done) return;
      done = true;
      d.removeEventListener('transitionend', onEnd);
      d.close();
      d.classList.remove('is-closing');
    };
    d.addEventListener('transitionend', onEnd);
    setTimeout(finish, 220);
  }

  function show(k: number) {
    if (!dlg || !set.length) return;
    at = (k + set.length) % set.length;
    const s = set[at];
    const q = <T extends Element>(sel: string) => dlg!.querySelector<T>(sel)!;
    const img = q<HTMLImageElement>('.lb-stage img');
    img.className = [s.portrait && 'portrait', s.framed && 'framed', 'loading'].filter(Boolean).join(' ');
    img.onload = () => img.classList.remove('loading');
    img.src = (dark() && s.dark) || s.src;
    img.alt = s.alt;
    q('.lb-name').textContent = s.name;
    const link = q<HTMLAnchorElement>('.lb-link');
    link.href = s.href;
    const external = /^https?:/.test(s.href);
    link.target = external ? '_blank' : '';
    link.rel = external ? 'noopener' : '';
    link.querySelector('span')!.textContent = s.link;
    const stars = q<HTMLElement>('.lb-stars');
    stars.hidden = !s.stars;
    stars.querySelector(':scope > span')!.textContent = s.stars ?? '';
    q('.lb-view').textContent = s.view;
    q('.lb-count').textContent = `${s.i} / ${s.n}`;
    q('.lb-note').textContent = s.note;
    // a set of one has nowhere to go
    dlg.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => (b.hidden = set.length < 2));
    // warm the next one
    const next = set[(at + 1) % set.length];
    new Image().src = (dark() && next.dark) || next.src;
  }

  function setup() {
    dlg = document.querySelector<HTMLDialogElement>('dialog.lb');
    if (!dlg || dlg.dataset.ready) return;
    dlg.dataset.ready = '1';
    sets = JSON.parse(dlg.querySelector('script')!.textContent ?? '{}');
    const d = dlg;
    d.querySelector('.lb-prev')!.addEventListener('click', () => show(at - 1));
    d.querySelector('.lb-next')!.addEventListener('click', () => show(at + 1));
    d.querySelector('.lb-close')!.addEventListener('click', closeLb);
    // a click on the backdrop (the dialog itself or the empty stage) closes it
    d.addEventListener('click', (e) => {
      if (e.target === d || e.target === d.querySelector('.lb-stage')) closeLb();
    });
    // Escape takes the same way out
    d.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeLb();
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
    let x0: number | null = null;
    d.addEventListener('pointerdown', (e) => (x0 = e.pointerType === 'mouse' ? null : e.clientX));
    d.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
    });
  }

  // any element with data-lb opens its set
  document.addEventListener('click', (e) => {
    const opener = (e.target as Element).closest<HTMLElement>('[data-lb]');
    if (!opener || !dlg) return;
    set = sets[opener.dataset.lb!] ?? [];
    if (!set.length) return;
    e.preventDefault();
    show(Number(opener.dataset.lbAt ?? 0));
    dlg.showModal();
    opener.dispatchEvent(new CustomEvent('lightbox:open', { bubbles: true }));
  });
  document.addEventListener('astro:page-load', setup);
</script>

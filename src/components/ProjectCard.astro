---
// small card for a case study that isn't featured: logo, tagline and live numbers
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Octicon from './Octicon.astro';
import { getRepo, getPackage, compact } from '../lib/data';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
const [repo, pkg] = await Promise.all([p.repo ? getRepo(p.repo) : undefined, p.package ? getPackage(p.package) : null]);
---

<a href={`/projects/${project.id}`} class="hover-card group flex flex-col rounded-xl border border-border bg-surface p-5">
  <div class="flex items-center gap-3">
    {
      p.logo ? (
        <Image src={p.logo} alt="" width={32} height={32} class="size-8 shrink-0 rounded-lg object-contain" />
      ) : (
        <Octicon name="book" size={20} class="shrink-0 text-subtle" />
      )
    }
    <h3 class="min-w-0 font-mono text-sm font-medium text-fg group-hover:text-accent transition-colors break-all">{p.title}</h3>
    <Icon name="arrow-right" size={14} class="ml-auto shrink-0 text-subtle group-hover:text-fg group-hover:translate-x-0.5 transition-all" />
  </div>
  <p class="mt-3 text-sm text-muted leading-relaxed">{p.tagline}</p>
  <div class="mt-auto pt-4 flex items-center gap-4 text-xs text-subtle tabular-nums">
    {
      repo && (
        <span class="flex items-center gap-1" title="GitHub stars">
          <Octicon name="star-fill" size={12} class="text-star" />
          {repo.stargazers_count}
        </span>
      )
    }
    {
      pkg && (
        <>
          <span class="flex items-center gap-1" title="pub.dev likes">
            <Octicon name="thumbsup" size={12} class="text-accent" />
            {pkg.likes}
          </span>
          <span class="flex items-center gap-1" title="pub.dev downloads, last 30 days">
            <Octicon name="download" size={12} />
            {compact(pkg.downloads30d)}/mo
          </span>
        </>
      )
    }
    {pkg?.version && <span class="ml-auto font-mono">v{pkg.version}</span>}
  </div>
</a>

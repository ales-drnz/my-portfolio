---
// small card for a case study that isn't featured, built from the same tiles as FeaturedProject:
// an intro tile over a row of live numbers (pub.dev stats when the case study ships a package)
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Octicon from './Octicon.astro';
import Sparkline from './Sparkline.astro';
import { getRepo, getPackage, compact, timeAgo } from '../lib/data';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
const [repo, pkg] = await Promise.all([p.repo ? getRepo(p.repo) : undefined, p.package ? getPackage(p.package) : null]);

const tile = 'rounded-[13px] bg-surface min-w-0';
const numTile = `${tile} px-3 py-3 flex flex-col justify-between gap-3`;
const label = 'flex items-center gap-1.5 text-xs text-subtle';
const value = 'text-xl font-semibold tracking-tight tabular-nums';
---

<a href={`/projects/${project.id}`} class="hover-card group flex flex-col gap-2 p-2 rounded-[20px] bg-surface-2">
  <!-- intro -->
  <div class:list={[tile, 'flex-1 p-4 flex flex-col gap-3']}>
    <div class="flex items-center gap-2.5">
      {
        p.logo ? (
          <Image src={p.logo} alt="" width={32} height={32} densities={[1, 2, 3]} class="size-8 shrink-0 rounded-lg object-contain" />
        ) : (
          <Octicon name="book" size={20} class="shrink-0 text-subtle" />
        )
      }
      <h3 class="min-w-0 font-mono text-sm font-medium text-fg group-hover:text-accent transition-colors break-all">{p.title}</h3>
      {pkg?.version && <span class="shrink-0 font-mono text-[11px] px-1.5 py-0.5 rounded-md bg-surface-2 text-muted">v{pkg.version}</span>}
      <Icon name="arrow-right" size={14} class="ml-auto shrink-0 text-subtle group-hover:text-fg group-hover:translate-x-0.5 transition-all" />
    </div>
    <p class="text-sm text-muted leading-relaxed line-clamp-2">{p.tagline}</p>
  </div>

  <!-- numbers -->
  <div class="grid grid-cols-3 gap-2 shrink-0">
    {
      pkg ? (
        <>
          <div class={numTile}>
            <span class={label}><Octicon name="star-fill" size={12} class="text-star" /> Stars</span>
            <span class={value}>{repo?.stargazers_count ?? '—'}</span>
          </div>
          <div class={numTile}>
            <span class={label}><Octicon name="thumbsup" size={12} class="text-accent" /> Likes</span>
            <span class={value}>{pkg.likes}</span>
          </div>
          <div class:list={[numTile, 'relative overflow-hidden']}>
            <span class:list={[label, 'relative z-10']}><Octicon name="download" size={12} /> /30d</span>
            <span class:list={[value, 'relative z-10']}>{compact(pkg.downloads30d)}</span>
            {pkg.weekly.length > 4 && <Sparkline edge values={pkg.weekly.slice(-26)} width={120} height={40} label={`Weekly downloads of ${pkg.name}, last 6 months`} class="absolute inset-x-0 bottom-0 h-1/2 w-full" />}
          </div>
        </>
      ) : (
        <>
          <div class={numTile}>
            <span class={label}><Octicon name="star-fill" size={12} class="text-star" /> Stars</span>
            <span class={value}>{repo?.stargazers_count ?? '—'}</span>
          </div>
          <div class={numTile}>
            <span class={label}><Octicon name="repo-push" size={12} /> Push</span>
            <span class="text-sm text-fg">{repo ? timeAgo(repo.pushed_at) : '—'}</span>
          </div>
          <div class={numTile}>
            <span class={label}>Platforms</span>
            <span class="text-sm text-fg line-clamp-2">{p.platforms.join(', ') || '—'}</span>
          </div>
        </>
      )
    }
  </div>
</a>

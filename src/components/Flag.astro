---
// flags as inline SVG: flag emoji don't render on Windows
interface Props {
  code: 'it' | 'gb';
  class?: string;
}

const { code, class: className } = Astro.props;
// the UK cross needs a clip path; give each instance its own id
const clip = `flag-gb-${Math.random().toString(36).slice(2, 8)}`;
const cls = ['w-auto rounded-[0.08em] ring-1 ring-black/10', className];
---

{
  code === 'it' ? (
    <svg viewBox="0 0 3 2" class:list={cls} role="img" aria-label="Italian flag">
      <rect width="1" height="2" fill="#009246" />
      <rect x="1" width="1" height="2" fill="#f1f2f1" />
      <rect x="2" width="1" height="2" fill="#ce2b37" />
    </svg>
  ) : (
    <svg viewBox="0 0 60 40" class:list={cls} role="img" aria-label="British flag">
      <clipPath id={clip}>
        <path d="M30,20 h30 v20 z v20 h-30 z h-30 v-20 z v-20 h30 z" />
      </clipPath>
      <rect width="60" height="40" fill="#012169" />
      <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8" />
      <path d="M0,0 L60,40 M60,0 L0,40" clip-path={`url(#${clip})`} stroke="#C8102E" stroke-width="5" />
      <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="12" />
      <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="7" />
    </svg>
  )
}

---
// Spoken languages as one line each: name, level, and what backs it.
import type { Language } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  languages: Language[];
  lang: Lang;
}

const { languages, lang } = Astro.props;
const T = t(lang).languages;
---

<div class="langs">
  <h3 class="eyebrow">{T.title}</h3>
  <ul>
    {
      languages.map((l) => (
        <li>
          <b>{l.name}</b>
          <span class="lv" title={l.level === 'native' ? T.nativeSpeaker : `${T.cefr} ${l.level}`}>
            {l.level === 'native' ? T.native : l.level}
          </span>
          <span class="txt">
            {l.levelLabel}
            {l.certificate && <> · {l.certificate.name}{l.certificate.score && ` (${l.certificate.score})`}</>}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  b {
    font-weight: 600;
    margin-right: var(--s-1);
  }
  .lv {
    margin-right: var(--s-1);
    font: 12px var(--font-mono);
    color: var(--c-accent);
  }
  .txt {
    color: var(--c-muted);
  }
</style>

---
import Flag from './Flag.astro';
import Octicon from './Octicon.astro';
import { CEFR, type Language } from '../lib/site';

interface Props {
  languages: Language[];
}

const { languages } = Astro.props;
---

<div>
  <h3 class="flex items-center gap-2 text-sm font-medium text-muted mb-4">
    <Octicon name="comment-discussion" size={16} class="text-subtle" /> Languages
  </h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {
      languages.map((l) => {
        // native speakers fill the whole scale
        const filled = l.level === 'native' ? CEFR.length : CEFR.indexOf(l.level) + 1;
        return (
          <article class="rounded-2xl border border-border bg-surface p-5">
            <div class="flex items-center gap-3">
              <Flag code={l.flag} class="h-6 shrink-0 rounded-[4px]" />
              <h4 class="font-semibold tracking-tight">{l.name}</h4>
              <span class="ml-auto font-mono text-sm text-accent">{l.level === 'native' ? 'Native' : l.level}</span>
            </div>

            {/* CEFR scale */}
            <div class="mt-5" role="img" aria-label={`${l.name}: ${l.level === 'native' ? 'native speaker' : `CEFR level ${l.level}`}`}>
              <div class="grid grid-cols-6 gap-1">
                {CEFR.map((_, i) => (
                  <span class:list={['h-1.5 rounded-full', i < filled ? 'bg-accent' : 'bg-surface-2']} />
                ))}
              </div>
              <div class="mt-1.5 grid grid-cols-6 gap-1 font-mono text-[10px] text-subtle text-center" aria-hidden="true">
                {CEFR.map((c, i) => (
                  <span class:list={[l.level !== 'native' && i === filled - 1 && 'text-fg']}>{c}</span>
                ))}
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-border flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
              <span class="text-muted">{l.levelLabel}</span>
              {l.certificate && (
                <span class="ml-auto inline-flex items-center gap-1.5 text-xs text-muted">
                  <Octicon name="verified" size={13} class="shrink-0 text-ok" />
                  {l.certificate.name}
                  {l.certificate.score && <span class="font-mono text-subtle">· {l.certificate.score}</span>}
                </span>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</div>

---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Sparkline from './Sparkline.astro';
import Octicon from './Octicon.astro';
import { getRepo, getPackage, compact, timeAgo } from '../lib/data';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const p = project.data;
const [repo, pkg] = await Promise.all([p.repo ? getRepo(p.repo) : undefined, p.package ? getPackage(p.package) : null]);
const poster = p.cover && p.coverVideo ? await getImage({ src: p.cover, width: 1200, format: 'webp' }) : null;
const href = `/projects/${project.id}`;

// media on the left, intro + a row of numbers on the right
const tile = 'rounded-[13px] bg-surface p-4 min-w-0';
const label = 'flex items-center gap-1.5 text-xs text-subtle';
const value = 'text-xl font-semibold tracking-tight tabular-nums';
// number tiles are tighter than the intro so the row stays short under a 16:9 cover
const numTile = 'rounded-[13px] bg-surface px-4 py-3 min-w-0';
---

<!--
  With a cover, the cover sets the card's height (shown whole, at its own aspect ratio) and the
  right column is laid over that height: the intro takes what the row of numbers leaves, so the two
  sides always end together. Without a cover, the intro and the numbers run full width.
-->
<article
  class:list={[
    'hover-card group grid grid-cols-1 gap-2 p-2 rounded-[20px] bg-surface-2',
    p.cover && 'md:grid-cols-2',
  ]}
>
  {
    p.cover && (
      <div class="rounded-[13px] bg-surface-2 overflow-hidden">
        {p.coverVideo && poster ? (
          <video
            src={p.coverVideo}
            poster={poster.src}
            width={p.cover.width}
            height={p.cover.height}
            muted
            loop
            playsinline
            preload="none"
            data-autoplay
            aria-label={p.coverAlt}
            class="block w-full h-auto"
          />
        ) : (
          <Image
            src={p.cover}
            alt={p.coverAlt ?? ''}
            widths={[600, 1000, 1400]}
            sizes="(min-width: 768px) 500px, 100vw"
            class="block w-full h-auto"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        )}
      </div>
    )
  }

  <div class:list={['flex flex-col gap-2 min-w-0', p.cover && 'md:relative']}>
    <div class:list={['flex flex-col gap-2', p.cover && 'md:absolute md:inset-0']}>
      <!-- intro -->
      <div class:list={[tile, 'flex-1 min-h-0 overflow-hidden flex flex-col gap-2']}>
        <div class="flex items-center gap-2.5">
          {p.logo && <Image src={p.logo} alt="" width={36} height={36} densities={[1, 2, 3]} class="size-9 rounded-lg object-contain" />}
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-subtle">{p.kind}</span>
          {pkg?.version && <span class="font-mono text-[11px] px-1.5 py-0.5 rounded-md bg-surface-2 text-muted">v{pkg.version}</span>}
        </div>
        <h3 class="text-xl font-semibold tracking-tight">
          <a href={href} class="after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none">{p.title}</a>
        </h3>
        <p class="text-sm text-muted leading-relaxed line-clamp-2">{p.tagline}</p>
        <div class="mt-auto flex flex-wrap gap-1.5">
          {p.stack.slice(0, 4).map((s) => <span class="font-mono text-[11px] px-2 py-0.5 rounded-md bg-surface-2 text-muted">{s}</span>)}
        </div>
      </div>

      <!-- numbers -->
      <div class="grid grid-cols-3 gap-2 shrink-0">
        <div class:list={[numTile, 'flex flex-col justify-between gap-3']}>
          <span class={label}><Octicon name="star-fill" size={12} class="text-star" /> Stars</span>
          <span class={value}>{repo?.stargazers_count ?? '—'}</span>
        </div>
        {
          pkg ? (
            <div class:list={[numTile, 'flex flex-col justify-between gap-3']}>
              <span class={label}><Octicon name="thumbsup" size={12} class="text-accent" /> Likes</span>
              <span class={value}>{pkg.likes}</span>
            </div>
          ) : (
            <div class:list={[numTile, 'flex flex-col justify-between gap-3']}>
              <span class={label}><Octicon name="repo-push" size={12} /> Last push</span>
              <span class={value}>{repo ? timeAgo(repo.pushed_at) : '—'}</span>
            </div>
          )
        }
        {
          pkg ? (
            <div class:list={[numTile, 'relative overflow-hidden flex flex-col justify-between gap-3']}>
              <span class:list={[label, 'relative z-10']}><Octicon name="download" size={12} /> /30d</span>
              <span class:list={[value, 'relative z-10']}>{compact(pkg.downloads30d)}</span>
              {pkg.weekly.length > 4 && <Sparkline edge values={pkg.weekly.slice(-26)} width={160} height={40} label="Weekly downloads, last 6 months" class="absolute inset-x-0 bottom-0 h-1/2 w-full" />}
            </div>
          ) : (
            <div class:list={[numTile, 'flex flex-col justify-between gap-3']}>
              <span class={label}>Platforms</span>
              <span class="text-sm text-fg line-clamp-2">{p.platforms.join(', ')}</span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</article>

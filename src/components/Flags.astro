---
// Italian and British flags as inline SVG: flag emoji don't render on Windows
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[0.18em] align-middle', className]}>
  <svg viewBox="0 0 3 2" class="h-[0.62em] w-auto rounded-[0.08em] ring-1 ring-black/10" role="img" aria-label="Italian">
    <rect width="1" height="2" fill="#009246" />
    <rect x="1" width="1" height="2" fill="#f1f2f1" />
    <rect x="2" width="1" height="2" fill="#ce2b37" />
  </svg>
  <svg viewBox="0 0 60 40" class="h-[0.62em] w-auto rounded-[0.08em] ring-1 ring-black/10" role="img" aria-label="English">
    <clipPath id="flag-uk-t"><path d="M30,20 h30 v20 z v20 h-30 z h-30 v-20 z v-20 h30 z" /></clipPath>
    <rect width="60" height="40" fill="#012169" />
    <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8" />
    <path d="M0,0 L60,40 M60,0 L0,40" clip-path="url(#flag-uk-t)" stroke="#C8102E" stroke-width="5" />
    <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="12" />
    <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="7" />
  </svg>
</span>

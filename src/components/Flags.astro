---
// the Italian + British pair used in the hero headline
import Flag from './Flag.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[0.18em] align-middle', className]}>
  <Flag code="it" class="h-[0.62em]" />
  <Flag code="gb" class="h-[0.62em]" />
</span>

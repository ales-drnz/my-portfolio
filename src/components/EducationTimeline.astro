---
// Studies as a ruled list: dates, degree and school, grade on the right; the thesis hangs under its degree.
import type { EducationEntry } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  entries: EducationEntry[];
  lang: Lang;
}

const { entries, lang } = Astro.props;
const T = t(lang).timeline;
---

<ol class="edu">
  {
    entries.map((e) => (
      <li>
        <p class="edu-when">
          {e.start} – {e.end ?? T.present}
        </p>
        <div class="edu-what">
          <h3>{e.degree}</h3>
          <p>{e.school} · {e.place}</p>
        </div>
        <p class:list={['edu-grade', !e.end && 'is-live']}>{e.grade ?? (e.end ? '' : T.inProgress)}</p>
        {e.thesis && (
          <div class="edu-thesis">
            <p class="edu-thesis-k">
              {T.thesis} · {T.supervisor} {e.thesis.supervisor}
            </p>
            <p class="edu-thesis-t">{e.thesis.title}</p>
            <p>{e.thesis.summary}</p>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) auto;
    gap: 6px var(--s-3);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-border);
  }
  li:first-child {
    padding-top: 0;
  }
  p {
    margin: 0;
  }
  .edu-when {
    padding-top: 3px;
    font: 12px var(--font-mono);
    color: var(--c-subtle);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .edu-what p {
    margin-top: 2px;
    font-size: 14px;
    color: var(--c-muted);
  }
  .edu-grade {
    padding-top: 2px;
    font: 13px var(--font-mono);
    text-align: right;
    white-space: nowrap;
  }
  .edu-grade.is-live {
    color: var(--c-accent);
  }
  .edu-thesis {
    grid-column: 2 / -1;
    margin-top: var(--s-1);
    padding-left: var(--s-2);
    border-left: 2px solid var(--c-accent);
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .edu-thesis-k {
    font: 11px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-subtle);
  }
  .edu-thesis-t {
    margin: 4px 0;
    color: var(--c-fg);
    font-weight: 500;
  }
  @media (max-width: 767px) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .edu-when,
    .edu-thesis {
      grid-column: 1 / -1;
    }
  }
</style>

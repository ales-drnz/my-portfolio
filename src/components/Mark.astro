---
// The al_ mark, drawn inline so its colours follow the theme (--c-mark, --c-mark-cursor, --c-disc)
import { MARK } from '../lib/brand';

interface Props {
  size?: number;
  disc?: boolean;
  class?: string;
  label?: string;
}
const { size = 32, disc = false, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {disc && <circle cx="50" cy="50" r="50" fill="var(--c-disc)" />}
  <g transform={MARK.fit} fill="none" stroke-width={MARK.weight} stroke-linecap="round" stroke-linejoin="round">
    <path d={MARK.stroke} stroke="var(--c-mark)" />
    <path d={MARK.cursor} stroke="var(--c-mark-cursor)" />
  </g>
</svg>

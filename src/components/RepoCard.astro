---
import Icon from './Icon.astro';
import Octicon from './Octicon.astro';
import { LANG_COLORS } from '../lib/site';
import { timeAgo, type Repo } from '../lib/data';

interface Props {
  repo: Repo;
  /** internal case-study page, when there is one */
  href?: string;
}

const { repo, href } = Astro.props;
const external = !href;
---

<a
  href={href ?? repo.html_url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class="hover-card group flex flex-col rounded-xl border border-border bg-surface p-5"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-sm font-medium text-fg group-hover:text-accent transition-colors break-all">{repo.name}</h3>
    <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={14} class="shrink-0 mt-0.5 text-subtle group-hover:text-fg transition-colors" />
  </div>
  <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-3">{repo.description ?? 'No description yet.'}</p>
  <div class="mt-auto pt-4 flex items-center gap-4 text-xs text-subtle">
    {
      repo.language && (
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full" style={`background:${LANG_COLORS[repo.language] ?? '#8b8b9e'}`} />
          {repo.language}
        </span>
      )
    }
    {
      repo.stargazers_count > 0 && (
        <span class="flex items-center gap-1">
          <Octicon name="star-fill" size={12} class="text-star" />
          {repo.stargazers_count}
        </span>
      )
    }
    <span class="ml-auto">{timeAgo(repo.pushed_at)}</span>
  </div>
</a>

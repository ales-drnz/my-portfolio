---
import Icon from './Icon.astro';
import Octicon from './Octicon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { LANG_COLORS, REPO_LOGOS } from '../lib/site';
import { timeAgo, type Repo } from '../lib/data';

interface Props {
  repo: Repo;
  /** internal case-study page, when there is one */
  href?: string;
}

const { repo, href } = Astro.props;
const external = !href;

// logos live in src/assets/projects/<path> so Astro can optimise them
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/**/*.png', { eager: true });
const logoPath = REPO_LOGOS[repo.name];
const logo = logoPath ? logos[`../assets/projects/${logoPath}`]?.default : undefined;
---

<a
  href={href ?? repo.html_url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class="hover-card group flex flex-col rounded-xl border border-border bg-surface p-5"
>
  <div class="flex items-center gap-3">
    {
      logo ? (
        <Image src={logo} alt="" width={32} height={32} class="size-8 shrink-0 rounded-lg object-contain" />
      ) : (
        <Octicon name="repo" size={20} class="shrink-0 text-subtle" />
      )
    }
    <h3 class="min-w-0 font-mono text-sm font-medium text-fg group-hover:text-accent transition-colors break-all">{repo.name}</h3>
    <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={14} class="ml-auto shrink-0 text-subtle group-hover:text-fg transition-colors" />
  </div>
  <p class="mt-3 text-sm text-muted leading-relaxed line-clamp-3">{repo.description ?? 'No description yet.'}</p>
  <div class="mt-auto pt-4 flex items-center gap-4 text-xs text-subtle">
    {
      repo.language && (
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full" style={`background:${LANG_COLORS[repo.language] ?? '#8b8b9e'}`} />
          {repo.language}
        </span>
      )
    }
    {
      repo.stargazers_count > 0 && (
        <span class="flex items-center gap-1">
          <Octicon name="star-fill" size={12} class="text-star" />
          {repo.stargazers_count}
        </span>
      )
    }
    <span class="ml-auto">{timeAgo(repo.pushed_at)}</span>
  </div>
</a>

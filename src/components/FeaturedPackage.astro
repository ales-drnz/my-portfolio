---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Sparkline from './Sparkline.astro';
import Octicon from './Octicon.astro';
import { getRepo, getPackage, compact } from '../lib/data';
import { t, localePath, type Lang } from '../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const T = t(lang);
const p = project.data;
const [repo, pkg] = await Promise.all([p.repo ? getRepo(p.repo) : undefined, p.package ? getPackage(p.package) : null]);
const href = localePath(lang, `/projects/${project.id}`);

const tile = 'rounded-[6px] bg-surface min-w-0';
const label = 'flex items-center gap-1.5 text-xs text-subtle';
const value = 'text-xl font-semibold tracking-tight tabular-nums';
---

<!--
  A featured pub.dev package with no cover: the download chart takes the place of the picture. Intro and
  the small numbers on the left, the weekly downloads on the right, as tall as the left column.
-->
<article class="hover-card group grid grid-cols-1 gap-2 p-2 rounded-2xl bg-surface-2 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div class="flex flex-col gap-2 min-w-0">
    <div class:list={[tile, 'flex-1 p-4 flex flex-col gap-2']}>
      <div class="flex items-center gap-2.5">
        {p.logo && <Image src={p.logo} alt="" width={36} height={36} densities={[1, 2, 3]} class="size-9 rounded-md object-contain" />}
        <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-subtle">{T.kind[p.kind]}</span>
        {pkg?.version && <span class="font-mono text-[11px] px-1.5 py-0.5 rounded-md bg-surface-2 text-muted">v{pkg.version}</span>}
      </div>
      <h3 class="text-xl font-semibold tracking-tight">
        <a href={href} class="after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none">{p.title}</a>
      </h3>
      <p class="text-sm text-muted leading-relaxed line-clamp-2">{p.tagline}</p>
      <div class="mt-auto pt-2 flex flex-wrap gap-1.5">
        {p.stack.slice(0, 4).map((s) => <span class="font-mono text-[11px] px-2 py-0.5 rounded-md bg-surface-2 text-muted">{s}</span>)}
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2">
      <div class:list={[tile, 'px-4 py-3 flex flex-col justify-between gap-3']}>
        <span class={label}><Octicon name="star-fill" size={12} class="text-star" /> {T.card.stars}</span>
        <span class={value}>{repo?.stargazers_count ?? '—'}</span>
      </div>
      <div class:list={[tile, 'px-4 py-3 flex flex-col justify-between gap-3']}>
        <span class={label}><Octicon name="thumbsup" size={12} class="text-accent" /> {T.card.likes}</span>
        <span class={value}>{pkg?.likes ?? '—'}</span>
      </div>
    </div>
  </div>

  <!-- downloads: the number over a chart that fills the tile -->
  <div class:list={[tile, 'relative overflow-hidden p-4 min-h-44 flex flex-col gap-1']}>
    <span class:list={[label, 'relative z-10']}><Octicon name="download" size={12} /> {T.project.downloads}</span>
    <span class="relative z-10 text-3xl font-semibold tracking-tight tabular-nums">{pkg ? compact(pkg.downloads30d) : '—'}</span>
    <span class="relative z-10 text-xs text-subtle">{T.project.weekly}</span>
    {
      pkg && pkg.weekly.length > 4 && (
        <Sparkline edge values={pkg.weekly.slice(-26)} width={600} height={160} label={T.card.weekly(p.title)} class="absolute inset-x-0 bottom-0 h-[62%] w-full" />
      )
    }
  </div>
</article>

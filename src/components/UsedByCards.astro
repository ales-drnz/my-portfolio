---
/* Other people's projects that depend on a package: a static gallery, not a carousel (with a handful
   of projects a carousel would cycle the same cards over and over). Every screenshot stands on a
   lit stage of the same height: phones in a bezel rising from the bottom, desktop apps whole in a
   window frame and twice as wide. While a card is hovered or focused its other screenshots take
   turns, with dots on the stage showing which one is up; at rest it always shows the first. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Octicon from './Octicon.astro';
import { getExternalRepo } from '../lib/data';
import type { UsedBy } from '../lib/islands';
import type { Lang } from '../lib/i18n';

interface Props {
  projects: UsedBy[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const live = await Promise.all(projects.map((p) => getExternalRepo(p.repo)));
const cards = projects
  .map((p, i) => ({ ...p, stars: live[i]?.stargazers_count ?? p.stars, wide: p.shots[0].src.width > p.shots[0].src.height }))
  .sort((a, b) => b.stars - a.stars);
---

<!-- a wide card takes two of five columns on large screens and a whole row of three on tablets -->
<ul class="grid grid-cols-1 gap-2 sm:grid-cols-3 lg:grid-cols-5">
  {cards.map((c) => {
    const [owner, name] = c.repo.split('/');
    return (
      <li class:list={['min-w-0', c.wide && 'sm:col-span-3 lg:col-span-2']}>
        <a href={`https://github.com/${c.repo}`} target="_blank" rel="noopener" data-shots class="hover-card group flex h-full flex-col overflow-hidden rounded-[6px] bg-surface">
          <div class:list={[
            'stage relative h-64 overflow-hidden bg-surface-2 flex justify-center',
            c.wide ? 'items-center px-5 sm:px-8' : 'items-start pt-7',
          ]}>
            <!-- every screenshot of a project has the same size, so they stack in one grid cell -->
            <div class:list={[
              'grid transition-transform duration-500 ease-out group-hover:-translate-y-1.5',
              c.wide ? 'w-full max-w-[26rem]' : 'w-[9.5rem] shrink-0',
            ]}>
              {c.shots.map((s, k) => (
                <Image
                  src={s.src}
                  alt={k === 0 ? s.alt[lang] : ''}
                  aria-hidden={k === 0 ? undefined : 'true'}
                  data-shot
                  widths={c.wide ? [480, 960] : [240, 480]}
                  sizes={c.wide ? '(min-width: 1024px) 340px, (min-width: 640px) 560px, 100vw' : '150px'}
                  class:list={[
                    '[grid-area:1/1] w-full h-auto transition-opacity duration-500',
                    k > 0 && 'opacity-0',
                    c.wide
                      ? 'rounded-lg ring-1 ring-black/40 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)]'
                      : 'rounded-[1.4rem] border-[5px] border-[#0c0d10] shadow-[0_18px_40px_-12px_rgb(0_0_0/0.6)]',
                  ]}
                />
              ))}
            </div>
            <span class="absolute left-3 top-3 z-[2] inline-flex items-center gap-1 rounded-full bg-surface/85 px-2 py-0.5 text-xs text-fg tabular-nums backdrop-blur-sm">
              <Octicon name="star-fill" size={11} class="text-star" /> {c.stars}
            </span>
            {c.shots.length > 1 && (
              <span class="absolute right-3 top-3 z-[2] inline-flex items-center gap-1 rounded-full bg-surface/85 px-2 py-1.5 backdrop-blur-sm" aria-hidden="true">
                {c.shots.map((_, k) => <span data-dot data-on={k === 0 ? '' : undefined} class="dot size-1.5 rounded-full" />)}
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col gap-1.5 p-4">
            <div class="flex items-start gap-2">
              <!-- owner on its own line: the narrow phone cards would split the name mid-word -->
              <h4 class="min-w-0 break-words font-mono">
                <span class="block text-xs text-subtle">{owner}</span>
                <span class="block text-sm font-medium text-fg group-hover:text-accent transition-colors">{name}</span>
              </h4>
              <Icon name="arrow-up-right" size={14} class="ml-auto mt-0.5 shrink-0 text-subtle group-hover:text-fg transition-colors" />
            </div>
            <p class="text-sm text-muted leading-relaxed">{c.note[lang]}</p>
          </div>
        </a>
      </li>
    );
  })}
</ul>

<style>
  /* a soft accent light from below, and a hairline floor where the phones are cut */
  .stage {
    background-image:
      radial-gradient(120% 70% at 50% 115%, var(--c-accent-soft), transparent 70%),
      linear-gradient(to top, color-mix(in oklab, var(--c-border) 60%, transparent), transparent 1px);
  }
  .dot {
    background: color-mix(in oklab, var(--c-fg) 30%, transparent);
    transition: background-color 0.3s, width 0.3s;
  }
  .dot[data-on] {
    width: 0.875rem;
    background: var(--c-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-shot] {
      transition: none;
    }
  }
</style>

<script>
  // while a card is hovered or focused, step through its screenshots; back to the first on leave
  const STEP = 1500;

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-shots]').forEach((card) => {
      if (card.dataset.ready) return;
      card.dataset.ready = '1';
      const shots = [...card.querySelectorAll<HTMLElement>('[data-shot]')];
      const dots = [...card.querySelectorAll<HTMLElement>('[data-dot]')];
      if (shots.length < 2) return;

      let current = 0;
      let timer: number | undefined;
      const show = (n: number) => {
        current = n;
        shots.forEach((s, k) => s.classList.toggle('opacity-0', k !== n));
        dots.forEach((d, k) => d.toggleAttribute('data-on', k === n));
      };
      const next = () => show((current + 1) % shots.length);
      const start = () => {
        if (timer !== undefined) return;
        next();
        timer = window.setInterval(next, STEP);
      };
      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
        show(0);
      };

      card.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && start());
      card.addEventListener('pointerleave', stop);
      card.addEventListener('focusin', start);
      card.addEventListener('focusout', stop);
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>

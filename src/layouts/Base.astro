---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIALS } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = SITE.avatar } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={SITE.avatar} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ales_drnz" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      url: SITE.url,
      image: SITE.avatar,
      sameAs: SOCIALS.map((s) => s.url),
    })} />

    <!-- set the theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        const apply = () => {
          let t = null;
          try { t = localStorage.getItem('theme'); } catch {}
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 bg-surface px-3 py-2 rounded-md">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // clips play only while on screen, and never with reduced motion
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const io = new IntersectionObserver(
        (entries) => {
          for (const { target, isIntersecting } of entries) {
            const v = target as HTMLVideoElement;
            if (isIntersecting && !reduced.matches) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.35 },
      );
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('video[data-autoplay]').forEach((v) => io.observe(v));
      });
    </script>
    <!-- GoatCounter: privacy-friendly, no cookies. Counted manually so client-side navigations register too. -->
    <script is:inline>
      window.goatcounter = { no_onload: true };
      let gcLast = null;
      const gcCount = () => {
        if (!window.goatcounter.count || gcLast === location.pathname) return;
        gcLast = location.pathname;
        window.goatcounter.count({ path: location.pathname });
      };
      document.addEventListener('astro:page-load', gcCount);
    </script>
    <script is:inline data-goatcounter="https://ales-drnz.goatcounter.com/count" async src="https://gc.zgo.at/count.js" onload="gcCount()"></script>
  </body>
</html>
